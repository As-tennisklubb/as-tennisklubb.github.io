---
/**
 * PageHeader – Sidetopp med hero-bilde og dot-pattern overlay.
 *
 * Mørk toppseksjon med tittel, ingress og valgfrie actions.
 * Strekker seg bak navbar på desktop (md:-mt-24 md:pt-24).
 *
 * Props:
 *   title       – H1-tekst (påkrevd).
 *   description – Ingresstekst under tittelen (maks 65ch bredde).
 *   variant     – "hero" | "compact". Default "compact".
 *   image       – Valgfritt bakgrunnsbilde (URL). Vises med gradient-overlay.
 *   heroCategory – Kategori for tilfeldig hero-bilde ("tennis", "padel", "bordtennis").
 *   class       – Ekstra klasser på ytre Box.
 *
 * Slots:
 *   actions – CTA-knapper eller ekstrainnhold under ingressen.
 */
import { cn } from "@/lib/cn";
import { getRandomHeroImage } from "@/lib/getRandomHeroImage";
import Heading from "../ui/Heading.astro";
import BodyLong from "../ui/BodyLong.astro";
import PageBlock from "../primitives/PageBlock.astro";
import VStack from "../primitives/VStack.astro";
import Box from "../primitives/Box.astro";

type Variant = "hero" | "compact";

interface Props {
  title: string;
  description?: string;
  variant?: Variant;
  image?: string;
  heroCategory?: string;
  class?: string;
}

const {
  title,
  description,
  variant = "compact",
  image,
  heroCategory,
  class: className,
} = Astro.props;

const heroImage = image ?? (heroCategory ? getRandomHeroImage(heroCategory) : undefined);
const hasActions = Astro.slots.has("actions");

const variantStyles: Record<Variant, { box: string; gap: string }> = {
  hero: {
    box: "py-16 md:py-40",
    gap: "6",
  },
  compact: {
    box: "py-16 md:py-40",
    gap: "6",
  },
};

const styles = variantStyles[variant];
---

<Box
  as="section"
  class={cn(
    "pattern-overlay relative overflow-hidden bg-gray-900 text-white md:-mt-24 md:pt-24",
    styles.box,
    className,
  )}
>
  {
    heroImage && (
      <>
        <picture>
          <source
            type="image/avif"
            srcset={`
              ${heroImage}-480.avif 480w,
              ${heroImage}-960.avif 960w,
              ${heroImage}-1440.avif 1440w,
              ${heroImage}-1920.avif 1920w
            `}
            sizes="100vw"
          />
          <source
            type="image/webp"
            srcset={`
              ${heroImage}-480.webp 480w,
              ${heroImage}-960.webp 960w,
              ${heroImage}-1440.webp 1440w,
              ${heroImage}-1920.webp 1920w
            `}
            sizes="100vw"
          />
          <img
            src={`${heroImage}-1440.webp`}
            alt=""
            aria-hidden="true"
            data-hero-img
            class="pointer-events-none absolute inset-0 h-full w-full object-cover select-none"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>

        <div class="absolute inset-0 bg-gray-900/20" aria-hidden="true" />
        <div
          class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/60 to-transparent"
          aria-hidden="true"
        />
      </>
    )
  }

  <PageBlock width="xl" gutters class="relative">
    <VStack gap={styles.gap} align="start">
      <Heading level={1} size="xlarge" dataColor="inverted">{title}</Heading>

      {
        description && (
          <BodyLong size="large" class="max-w-[65ch] text-[var(--aastk-text-on-brand-muted)]">
            {description}
          </BodyLong>
        )
      }

      {hasActions && <slot name="actions" />}
    </VStack>
  </PageBlock>
</Box>
