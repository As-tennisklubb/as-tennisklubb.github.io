---
import { cn } from "@/lib/cn";

interface Props {
  cols?: 2 | 3;
  class?: string;
}

const { cols = 3, class: className } = Astro.props;

const colClasses = {
  2: "grid gap-6 md:grid-cols-2",
  3: "grid gap-6 md:grid-cols-2 lg:grid-cols-3",
};
---

<div class={cn(colClasses[cols], className)}>
  <slot />
</div>
