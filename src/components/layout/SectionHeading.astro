---
import { cn } from "@/lib/cn";

interface Props {
  title: string;
  icon?: (_props: Record<string, any>) => any;
  class?: string;
}

const { title, icon: Icon, class: className } = Astro.props;
---

<h2
  class={cn(
    "flex items-center gap-3 mb-4 text-2xl font-bold text-brand-800 dark:text-brand-300",
    className,
  )}
>
  {Icon && <Icon class="h-6 w-6" />}
  {title}
</h2>
