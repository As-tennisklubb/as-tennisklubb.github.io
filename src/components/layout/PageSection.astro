---
import { cn } from "@/lib/cn";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title?: string;
  icon?: astroHTML.JSX.Element;
  id?: string;
  class?: string;
}

const { title, icon: Icon, id, class: className } = Astro.props;
---

<section id={id} class={cn("mb-10 last:mb-0", className)}>
  {title && <SectionHeading title={title} icon={Icon} />}
  <slot />
</section>
