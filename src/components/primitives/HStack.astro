---
/**
 * HStack – Flex-basert horisontal grouping.
 *
 * Speiler Aksel HStack: display:flex, flex-direction:row.
 *
 * Props:
 *   gap          – Tailwind spacing-skala. Mapper til gap-klasser.
 *   justify      – CSS justify-content.
 *   align        – CSS align-items.
 *   wrap         – Aktiverer flex-wrap.
 *   padding      – Tailwind spacing-skala. Mapper til p-klasser.
 *   paddingInline– Tailwind spacing-skala. Mapper til px-klasser.
 *   paddingBlock – Tailwind spacing-skala. Mapper til py-klasser.
 *   as           – HTML-element å rendre som.
 *
 * Alle klasser bruker eksplisitte oppslagskart for å sikre at Tailwind plukker dem opp.
 */
import { cn } from "@/lib/cn";
import type { HTMLTag } from "astro/types";
import {
  gapClass,
  alignItemsClass,
  justifyContentClass,
  paddingClass,
  paddingInlineClass,
  paddingBlockClass,
} from "@/lib/ui/classMaps";

interface Props {
  gap?: string;
  justify?: "start" | "center" | "end" | "space-between" | "space-around" | "space-evenly";
  align?: "start" | "center" | "end" | "baseline" | "stretch";
  wrap?: boolean;
  padding?: string;
  paddingInline?: string;
  paddingBlock?: string;
  as?: HTMLTag;
  class?: string;
}

const {
  gap,
  justify,
  align,
  wrap,
  padding,
  paddingInline,
  paddingBlock,
  as: Tag = "div",
  class: className,
} = Astro.props;
---

<Tag
  class={cn(
    "flex flex-row",
    gap && gapClass[gap],
    justify && justifyContentClass[justify],
    align && alignItemsClass[align],
    wrap && "flex-wrap",
    padding && paddingClass[padding],
    paddingInline && paddingInlineClass[paddingInline],
    paddingBlock && paddingBlockClass[paddingBlock],
    className,
  )}
>
  <slot />
</Tag>
