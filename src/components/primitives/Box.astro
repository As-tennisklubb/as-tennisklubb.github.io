---
/**
 * Box – Enkel stylable wrapper for visuell styling.
 *
 * Speiler Aksel Box: setter padding, background, border og borderRadius
 * via props. Brukes som byggestein, ikke layout-motor.
 *
 * Props:
 *   padding        – Tailwind spacing-skala. Mapper til p-klasser.
 *   paddingInline  – Tailwind spacing-skala. Mapper til px-klasser.
 *   paddingBlock   – Tailwind spacing-skala. Mapper til py-klasser.
 *   background     – Tailwind bakgrunnsklasse uten prefiks, f.eks. "white", "gray-50".
 *   borderRadius   – Tailwind radius-verdi: "none" | "sm" | "md" | "lg" | "xl" | "2xl" | "full".
 *   borderWidth    – Tailwind border-width: "0" | "1" | "2" | "4" | "8" (default border = 1px).
 *   borderColor    – Tailwind border-farge uten prefiks, f.eks. "gray-200".
 *   shadow         – Tailwind shadow: "sm" | "md" | "lg" | "xl" | "2xl".
 *   as             – HTML-element å rendre som.
 *
 * Astro-avvik fra Aksel:
 * - background/borderColor/borderRadius tar Tailwind-verdier i stedet for Aksel-tokens.
 * - Ingen ResponsiveProp; bruk class for responsive overrides.
 */
import { cn } from "@/lib/cn";
import type { HTMLTag } from "astro/types";
import { paddingClass, paddingInlineClass, paddingBlockClass } from "@/lib/ui/classMaps";

interface Props {
  padding?: string;
  paddingInline?: string;
  paddingBlock?: string;
  background?: string;
  borderRadius?: string;
  borderWidth?: string;
  borderColor?: string;
  shadow?: string;
  as?: HTMLTag;
  class?: string;
}

Astro.props satisfies Props;

const {
  padding,
  paddingInline,
  paddingBlock,
  background,
  borderRadius,
  borderWidth,
  borderColor,
  shadow,
  as: Tag = "div",
  class: className,
} = Astro.props;

const radiusClass: Record<string, string> = {
  none: "rounded-none",
  sm: "rounded-sm",
  md: "rounded-md",
  lg: "rounded-lg",
  xl: "rounded-xl",
  "2xl": "rounded-2xl",
  full: "rounded-full",
};

const shadowClass: Record<string, string> = {
  sm: "shadow-sm",
  md: "shadow-md",
  lg: "shadow-lg",
  xl: "shadow-xl",
  "2xl": "shadow-2xl",
};

const borderWidthClass: Record<string, string> = {
  "0": "border-0",
  "1": "border",
  "2": "border-2",
  "4": "border-4",
  "8": "border-8",
};

const backgroundClass: Record<string, string> = {
  white: "bg-white",
  "gray-50": "bg-gray-50",
  "gray-100": "bg-gray-100",
  "gray-200": "bg-gray-200",
  "gray-800": "bg-gray-800",
  "gray-900": "bg-gray-900",
  "gray-950": "bg-gray-950",
  "brand-50": "bg-brand-50",
  "brand-100": "bg-brand-100",
  "brand-200": "bg-brand-200",
  "brand-700": "bg-brand-700",
  "brand-800": "bg-brand-800",
  "brand-900": "bg-brand-900",
};

const borderColorClass: Record<string, string> = {
  "gray-100": "border-gray-100",
  "gray-200": "border-gray-200",
  "gray-300": "border-gray-300",
  "gray-700": "border-gray-700",
  "gray-800": "border-gray-800",
  "brand-100": "border-brand-100",
  "brand-200": "border-brand-200",
  "brand-700": "border-brand-700",
  "brand-800": "border-brand-800",
  "brand-900": "border-brand-900",
};
---

<Tag
  class={cn(
    padding && paddingClass[padding],
    paddingInline && paddingInlineClass[paddingInline],
    paddingBlock && paddingBlockClass[paddingBlock],
    background && backgroundClass[background],
    borderRadius && radiusClass[borderRadius],
    borderWidth && borderWidthClass[borderWidth],
    borderColor && borderColorClass[borderColor],
    shadow && shadowClass[shadow],
    className,
  )}
>
  <slot />
</Tag>
