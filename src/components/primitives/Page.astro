---
/**
 * Page – Top-level layout primitive.
 *
 * Speiler Aksel Page: etablerer siderammen med full høyde og flex-column
 * slik at footer kan plasseres nederst.
 *
 * Astro-avvik fra Aksel:
 * - Ingen footer/footerPosition/contentBlockPadding props.
 *   I Astro styres dette naturlig av Layout.astro og <slot />.
 * - Ingen as="body" variant – Astro har <body> i Layout.
 */
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("flex min-h-screen flex-col", className)}>
  <slot />
</div>
