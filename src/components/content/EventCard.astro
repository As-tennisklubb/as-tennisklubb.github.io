---
/**
 * EventCard – Arrangementkort.
 *
 * Strukturelt identisk med NewsCard: rolig redaksjonell stil.
 * Viser badges, dato, tittel, teaser og CTA.
 *
 * Props:
 *   event – PublicClubEvent-objekt fra API.
 *   class – Tilpassinger.
 */
import { cn } from "@/lib/cn";
import Card from "../ui/Card.astro";
import Heading from "../ui/Heading.astro";
import BodyLong from "../ui/BodyLong.astro";
import SportBadge from "../ui/SportBadge.astro";
import type { PublicClubEvent } from "../../lib/events/mapPublicEvent";
import { formatDateRange } from "../../lib/events/formatEvent";
import { extractTiptapTeaser } from "../../lib/events/renderTiptapJson";

interface Props {
  event: PublicClubEvent;
  class?: string;
}

const { event, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
const showCategory = event.category !== event.title;
const dateRange = formatDateRange(event.startDate, event.endDate);
const teaser = extractTiptapTeaser(event.description);
const sport = (["tennis", "bordtennis", "padel"] as const).includes(event.grenSlug as any)
  ? (event.grenSlug as "tennis" | "bordtennis" | "padel")
  : undefined;
---

<Card class={cn("h-full", className)}>
  <a href={`${base}arrangementer/${event.arrangementId}`} class="group flex h-full flex-col">
    <div class="flex flex-wrap items-center gap-2">
      {sport && <SportBadge sport={sport} />}
      <p class="text-muted text-xs font-medium">
        {dateRange}{showCategory && ` · ${event.category}`}
      </p>
    </div>
    <Heading
      level={2}
      size="xsmall"
      class="mt-2 transition-colors group-hover:text-[var(--aastk-text-brand)]"
    >
      {event.title}
    </Heading>
    {
      teaser && (
        <BodyLong size="small" class="text-body mt-3 line-clamp-2">
          {teaser}
        </BodyLong>
      )
    }
    <p
      class="mt-auto pt-4 text-sm font-medium text-[var(--aastk-link-default)] transition-colors group-hover:text-[var(--aastk-link-hover)]"
    >
      Les mer →
    </p>
  </a>
</Card>
