---
import type { PublicClubEvent } from "../../lib/events/mapPublicEvent";
import { formatDateRange, formatWeekday } from "../../lib/events/formatEvent";

interface Props {
  event: PublicClubEvent;
}

const { event } = Astro.props;
const dateRange = formatDateRange(event.startDate, event.endDate);
const hasWeekdays = event.weekdays.length > 0;
const showCategory = event.category !== event.title;
const slotMinutes = event.courtGroups[0]?.slotLengthMinutes ?? null;
const allTimes = [...new Set(event.courtGroups.flatMap((g) => g.times))];
---

<li>
  <div
    class="flex flex-col gap-3 rounded-xl border border-brand-100 bg-brand-50 px-6 py-5 shadow-sm dark:border-gray-700 dark:bg-gray-800"
  >
    <div>
      <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">
        {event.title}{
          slotMinutes && (
            <span class="ml-1 text-sm font-normal text-gray-500 dark:text-gray-400">
              ({slotMinutes} min)
            </span>
          )
        }
      </h3>
      <p class="mt-1 text-sm text-brand-700 dark:text-brand-400">
        {dateRange}{showCategory && ` · ${event.category}`}
      </p>
    </div>

    {
      event.description && (
        <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">{event.description}</p>
      )
    }

    {
      (hasWeekdays || allTimes.length > 0) && (
        <div class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
          {hasWeekdays && <p>{event.weekdays.map(formatWeekday).join(", ")}</p>}
          {allTimes.length > 0 && <p>{allTimes.join(" · ")}</p>}
        </div>
      )
    }
  </div>
</li>
