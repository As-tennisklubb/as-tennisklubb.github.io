---
import { cn } from "@/lib/cn";

interface Props {
  href: string;
  title: string;
  date: string;
  categories?: string[];
  excerpt?: string;
  headingLevel?: "h2" | "h3";
  clampLines?: 2 | 3;
  class?: string;
}

const {
  href,
  title,
  date,
  categories = [],
  excerpt,
  headingLevel = "h3",
  clampLines = 2,
  class: className,
} = Astro.props;
const headingClasses =
  "text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors";
const clampClass = clampLines === 3 ? "line-clamp-3" : "line-clamp-2";
---

<a
  href={href}
  class={cn(
    "group flex flex-col bg-brand-50 dark:bg-gray-800 border border-brand-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5",
    className,
  )}
>
  {
    headingLevel === "h2" ? (
      <h2 class={headingClasses}>{title}</h2>
    ) : (
      <h3 class={headingClasses}>{title}</h3>
    )
  }
  <p class="mt-1 text-sm text-brand-700 dark:text-brand-400">
    {date}{categories.length > 0 && ` · ${categories.join(", ")}`}
  </p>
  {
    excerpt && (
      <p class={cn("mt-2 text-sm text-gray-600 dark:text-gray-400", clampClass)}>{excerpt}</p>
    )
  }
</a>