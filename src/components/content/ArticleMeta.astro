---
import Badge from "../ui/Badge.astro";

interface Props {
  date: string;
  author?: string;
  categories?: string[];
  class?: string;
}

const { date, author, categories = [], class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-3", className]}>
  <Badge variant="date">{date}</Badge>
  {author && <span class="text-sm text-gray-500 dark:text-gray-400">av {author}</span>}
  {categories.map((cat) => <Badge variant="category">{cat}</Badge>)}
</div>
