---
import { cn } from "@/lib/cn";

interface Props {
  href: string;
  title: string;
  description: string;
  linkText: string;
  class?: string;
}

const { href, title, description, linkText, class: className } = Astro.props;
---

<a
  href={href}
  class={cn(
    "group flex flex-col bg-accent-50 dark:bg-gray-800 border border-accent-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5",
    className,
  )}
>
  <h2
    class="mb-2 text-lg font-bold text-gray-900 transition-colors group-hover:text-accent-700 dark:text-gray-100 dark:group-hover:text-accent-400"
  >
    {title}
  </h2>
  <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
  <span
    class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-accent-700 dark:text-accent-400"
    >{linkText}</span
  >
</a>
