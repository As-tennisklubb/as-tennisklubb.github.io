---
import { cn } from "@/lib/cn";

interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<ol class={cn("grid gap-6 md:grid-cols-3", className)}>
  {
    steps.map(({ title, text }, i) => (
      <li class="flex gap-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-800 dark:bg-brand-900 dark:text-brand-300">
          {i + 1}
        </span>
        <div>
          <p class="font-semibold text-gray-900 dark:text-gray-100">{title}</p>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{text}</p>
        </div>
      </li>
    ))
  }
</ol>
