---
import { MapPin } from "@lucide/astro";

interface Props {
  address: string;
  city: string;
  embedQuery: string;
  mapsUrl: string;
  buttonText?: string;
  linkText?: string;
}

const {
  address,
  city,
  embedQuery,
  mapsUrl,
  buttonText = "Vis kart",
  linkText = "Åpne i Google Maps",
} = Astro.props;

const placeholderId = "kart-placeholder";
const iframeId = "kart-iframe";
const btnId = "kart-btn";
---

<div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-700">
  <!-- Placeholder – vises til brukeren klikker -->
  <div
    id={placeholderId}
    class="relative flex h-[300px] cursor-pointer flex-col items-center justify-center gap-4 bg-brand-50 md:h-[400px] dark:bg-gray-800"
  >
    <MapPin class="h-10 w-10 text-brand-700 dark:text-brand-400" aria-hidden="true" />
    <div class="text-center">
      <p class="font-semibold text-gray-800 dark:text-gray-200">{address}</p>
      <p class="text-sm text-gray-500 dark:text-gray-400">{city}</p>
    </div>
    <button
      id={btnId}
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-brand-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-800"
    >
      {buttonText}
    </button>
  </div>

  <!-- Iframe – lastes kun ved klikk -->
  <iframe
    id={iframeId}
    title="Kart"
    width="100%"
    height="400"
    referrerpolicy="no-referrer-when-downgrade"
    class="block hidden w-full"></iframe>
</div>

<a
  href={mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="link mt-3 inline-flex min-h-[44px] items-center gap-1 text-sm"
>
  {linkText}
</a>

<script define:vars={{ placeholderId, iframeId, btnId, embedQuery }}>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById(btnId);
    const placeholder = document.getElementById(placeholderId);
    const iframe = document.getElementById(iframeId);

    btn?.addEventListener("click", () => {
      if (!iframe) return;
      iframe.src = `https://maps.google.com/maps?q=${encodeURIComponent(embedQuery)}&output=embed`;
      placeholder?.classList.add("hidden");
      iframe.classList.remove("hidden");
    });
  });
</script>
