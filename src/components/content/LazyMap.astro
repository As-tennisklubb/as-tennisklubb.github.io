---
/**
 * LazyMap – Kartkomponent med lazy-loading.
 *
 * Viser en placeholder med adresse og «Vis kart»-knapp.
 * Google Maps-iframe lastes først ved brukerinteraksjon.
 * Hver instans genererer unike ID-er, trygt for gjenbruk.
 *
 * Props:
 *   address    – Gateadresse (vises i placeholder).
 *   city       – Poststed (vises sekundært).
 *   embedQuery – Søkestreng for Google Maps embed.
 *   mapsUrl    – Full URL til Google Maps for ekstern lenke.
 *   buttonText – Tekst på «Vis kart»-knappen. Default "Vis kart".
 *   linkText   – Tekst på ekstern lenke. Default "Åpne i Google Maps".
 */
import { MapPin } from "@lucide/astro";
import Box from "../primitives/Box.astro";
import VStack from "../primitives/VStack.astro";
import Button from "../ui/Button.astro";
import Link from "../ui/Link.astro";
import BodyLong from "../ui/BodyLong.astro";

interface Props {
  address: string;
  city: string;
  embedQuery: string;
  mapsUrl: string;
  buttonText?: string;
  linkText?: string;
}

const {
  address,
  city,
  embedQuery,
  mapsUrl,
  buttonText = "Vis kart",
  linkText = "Åpne i Google Maps",
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 9);
const placeholderId = `kart-ph-${uid}`;
const iframeId = `kart-if-${uid}`;
const btnId = `kart-btn-${uid}`;
---

<Box
  borderRadius="xl"
  borderWidth="1"
  borderColor="gray-200"
  shadow="sm"
  class="overflow-hidden dark:border-gray-700"
>
  {/* Placeholder – vises til brukeren klikker */}
  <div
    id={placeholderId}
    class="flex h-75 flex-col items-center justify-center gap-4 bg-brand-50 md:h-100 dark:bg-gray-800"
  >
    <MapPin class="h-10 w-10 text-brand-700 dark:text-brand-400" aria-hidden="true" />
    <VStack gap="0" align="center">
      <BodyLong as="span" class="font-semibold text-heading">{address}</BodyLong>
      <BodyLong as="span" size="small" class="text-muted">{city}</BodyLong>
    </VStack>
    <Button id={btnId} size="small">{buttonText}</Button>
  </div>

  {/* Iframe – lastes kun ved klikk */}
  <iframe
    id={iframeId}
    title="Kart"
    width="100%"
    height="400"
    referrerpolicy="no-referrer-when-downgrade"
    class="hidden w-full"
  ></iframe>
</Box>

<Link
  href={mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  dataColor="subtle"
  class="mt-3 text-sm"
>
  {linkText}
</Link>

<script define:vars={{ placeholderId, iframeId, btnId, embedQuery }}>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById(btnId);
    const placeholder = document.getElementById(placeholderId);
    const iframe = document.getElementById(iframeId);

    btn?.addEventListener("click", () => {
      if (!iframe) return;
      iframe.src = `https://maps.google.com/maps?q=${encodeURIComponent(embedQuery)}&output=embed`;
      placeholder?.classList.add("hidden");
      iframe.classList.remove("hidden");
    });
  });
</script>
