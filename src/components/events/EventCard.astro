---
import { cn } from "@/lib/cn";
import type { PublicClubEvent } from "../../lib/events/mapPublicEvent";
import { formatPresentation, formatSignupStatus } from "../../lib/events/formatEvent";

interface Props {
  event: PublicClubEvent;
  class?: string;
}

const { event, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
const pLines = formatPresentation(event.presentation);
const showCategory = event.category !== event.title;
const signupStatus = formatSignupStatus(event.allowsSignup, event.signupCount);
---

<a
  href={`${base}arrangementer/${event.arrangementId}`}
  class={cn(
    "group flex flex-col bg-brand-50 dark:bg-gray-800 border border-brand-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5",
    className,
  )}
>
  <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">
    {event.title}
  </h2>
  <p class="mt-1 text-sm text-brand-700 dark:text-brand-400">
    {pLines.date}{showCategory && ` · ${event.category}`}
  </p>
  {pLines.schedule && (
    <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400">{pLines.schedule}</p>
  )}
  <p class={cn(
    "mt-2 text-sm",
    event.allowsSignup ? "text-brand-600 dark:text-brand-400" : "text-gray-500 dark:text-gray-400"
  )}>
    {signupStatus}
  </p>
</a>
