---
/**
 * Process – Aksel-inspirert prosessvisning.
 *
 * Viser en ordnet liste med hendelser/steg i en prosess.
 * Speiler Aksel Process-konseptet: statisk prosess, ikke interaktiv stepper.
 *
 * Props:
 *   class – Ekstra klasser for ytre <ol>.
 *
 * Slots:
 *   default – ProcessEvent-komponenter.
 */
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ol
  class={cn(
    "flex flex-col [&>li:last-of-type_.process-line]:hidden [&>li:last-of-type>div:last-child]:pb-0",
    className,
  )}
  role="list"
>
  <slot />
</ol>
