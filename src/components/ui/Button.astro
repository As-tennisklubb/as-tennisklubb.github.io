---
import { cn } from "@/lib/cn";

interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "highlight";
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = "primary", href, class: className, ...rest } = Astro.props;

const variants = {
  primary: "bg-brand-700 hover:bg-brand-800 text-white",
  secondary: "bg-accent-500 hover:bg-accent-600 text-white",
  outline:
    "border border-brand-700 text-brand-700 hover:bg-brand-50 dark:border-brand-500 dark:text-brand-400 dark:hover:bg-brand-900",
  ghost: "border border-brand-500 text-white hover:bg-brand-700",
  highlight: "bg-yellow-400 hover:bg-yellow-300 text-gray-900",
};

const classes = cn(
  "inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold transition min-h-[44px]",
  variants[variant],
  className,
);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
