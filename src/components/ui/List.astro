---
/**
 * List – Aksel-inspirert listekomponent.
 *
 * Brukes til å presentere innhold på en kortfattet og oversiktlig måte.
 * Egnet til å oppsummere tekst og liste opp kriterier.
 * Uegnet til lengre/rikt innhold per punkt.
 *
 * Props:
 *   as   – "ul" | "ol". Default "ul".
 *          ul: Hvert ListItem vises med en bullet-markør (eller egendefinert ikon).
 *          ol: Hvert ListItem vises med et automatisk løpenummer.
 *   size – "small" | "medium" | "large". Default "medium".
 *
 * Barn: ListItem (ListItem.astro).
 *
 * Tittel brukes IKKE som prop – bruk Heading utenfor lista.
 */
import { cn } from "@/lib/cn";

type ListTag = "ul" | "ol";
type ListSize = "small" | "medium" | "large";

interface Props {
  as?: ListTag;
  size?: ListSize;
  class?: string;
}

Astro.props satisfies Props;

const { as: Tag = "ul", size = "medium", class: className } = Astro.props;

const sizeClasses: Record<ListSize, string> = {
  large: "text-xl leading-7 gap-3",
  medium: "text-lg leading-7 gap-2",
  small: "text-base leading-6 gap-1.5",
};
---

<Tag
  class={cn("flex flex-col list-none pl-0", sizeClasses[size as ListSize], className)}
  data-list-as={Tag}
  data-list-size={size}
>
  <slot />
</Tag>

<style is:global>
  /* ── Unordered list: bullet dot ── */
  [data-list-as="ul"] > li > .aksel-list-marker {
    margin-top: 0.6em;
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--aastk-border-brand-strong);
  }

  /* ── Ordered list: counter number ── */
  [data-list-as="ol"] {
    counter-reset: aksel-list;
  }
  [data-list-as="ol"] > li {
    counter-increment: aksel-list;
  }
  [data-list-as="ol"] > li > .aksel-list-marker::before {
    content: counter(aksel-list) ".";
    font-weight: 600;
    color: var(--aastk-border-brand-strong);
  }
</style>
