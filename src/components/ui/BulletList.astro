---
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={["space-y-3 text-sm text-gray-700 dark:text-gray-300", className]}>
  {
    items.map((item) => (
      <li class="flex gap-2">
        <span class="shrink-0 text-brand-600 dark:text-brand-400">•</span>
        <span set:html={item} />
      </li>
    ))
  }
</ul>
