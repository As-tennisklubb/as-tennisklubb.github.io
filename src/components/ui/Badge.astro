---
import { cn } from "@/lib/cn";

interface Props {
  variant?: "default" | "date" | "category";
  class?: string;
}

const { variant = "default", class: className } = Astro.props;

const styles = {
  default:
    "text-xs text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-700 border border-brand-100 dark:border-gray-600 px-2 py-0.5 rounded-full",
  date: "text-xs font-medium text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/30 px-2 py-0.5 rounded-full",
  category:
    "text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded-full",
};
---

<span class={cn(styles[variant], className)}>
  <slot />
</span>
