---
import { cn } from "@/lib/cn";

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<div
  class={cn(
    "bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6",
    className,
  )}
>
  {title && <h3 class="mb-2 font-semibold text-gray-900 dark:text-gray-100">{title}</h3>}
  {description && <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>}
  <slot />
</div>
