---
import { cn } from "@/lib/cn";

interface Props {
  variant?: "info" | "success" | "warning";
  class?: string;
}

const { variant = "info", class: className } = Astro.props;

const styles = {
  info: "bg-brand-50 dark:bg-gray-800 border-brand-200 dark:border-brand-800",
  success: "bg-brand-50 dark:bg-gray-800 border-brand-300 dark:border-brand-700",
  warning: "bg-yellow-50 dark:bg-gray-800 border-yellow-200 dark:border-yellow-700",
};
---

<div
  class={cn(
    "rounded-xl border p-6 text-sm text-gray-700 dark:text-gray-300",
    styles[variant],
    className,
  )}
>
  <slot />
</div>
