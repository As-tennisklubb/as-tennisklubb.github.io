---
import { cn } from "@/lib/cn";

interface Props {
  cite?: string;
  class?: string;
}

const { cite, class: className } = Astro.props;
---

<div class={cn("pl-5 border-l-4 border-brand-600 dark:border-brand-500", className)}>
  <p class="text-lg leading-relaxed text-gray-700 italic dark:text-gray-300">
    <slot />
  </p>
  {cite && <p class="mt-3 text-sm font-medium text-brand-700 dark:text-brand-400">{cite}</p>}
</div>
