---
/**
 * InlineInfo – Subtil informasjonsblokk for støtteinnhold.
 *
 * Kompakt støtteblokk med rolig brand-bakgrunn og svak
 * venstrekant. Brukes som lavmælt kontekstuell info,
 * ikke som alert eller melding.
 *
 * Props:
 *   class – Ekstra klasser for layout-justeringer.
 *   as    – HTML-element (default "div").
 *
 * Slots:
 *   default – Innholdet i blokken.
 */
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
  as?: "div" | "aside" | "section";
}

const { class: className, as: Tag = "div" } = Astro.props;
---

<Tag
  class={cn(
    "rounded-lg border-l-[3px] px-5 py-4 text-sm",
    "bg-[var(--aastk-surface-brand-soft)]",
    "[border-color:var(--aastk-border-brand-subtle)]",
    className,
  )}
>
  <slot />
</Tag>
