---
/**
 * LinkCard – Aksel-lane navigasjonskort.
 *
 * Parallell kopi av content/LinkCard.astro.
 * Bruker aksel/Card som surface og aksel-typografi for innhold.
 * Hele kortet er klikkbart via en ytre <a>.
 *
 * Props:
 *   href        – URL kortet lenker til.
 *   title       – Korttittel.
 *   description – Kort beskrivelse.
 *   linkText    – Handlingstekst nederst.
 *   class       – Tilpassinger.
 */
import { cn } from "@/lib/cn";
import Card from "./Card.astro";
import Heading from "./Heading.astro";
import BodyLong from "./BodyLong.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  linkText: string;
  class?: string;
}

const { href, title, description, linkText, class: className } = Astro.props;
---

<Card class={cn("h-full", className)}>
  <a href={href} class="group flex h-full flex-col">
    <Heading level={2} size="xsmall" class="transition-colors group-hover:text-[var(--aastk-link-accent)]">
      {title}
    </Heading>
    <BodyLong size="small" class="mt-3 text-body">
      {description}
    </BodyLong>
    <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-[var(--aastk-link-accent)]">
      {linkText}
    </span>
  </a>
</Card>
