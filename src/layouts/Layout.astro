---
import "../styles/global.css";
import { Globe, Menu, X } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  pageTitle?: string;
  pageDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  languageAlternates?: Array<{ href: string; hrefLang: string }>;
}

const { title = "Ås Tennisklubb", description = "Ås Tennisklubb – tennis for alle i Ås", lang = "no", pageTitle, pageDescription, ogImage, ogImageAlt, noindex = false, languageAlternates } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: "trening",    label: "Trening" },
  { href: "baner",      label: "Baner" },
  { href: "nyheter",    label: "Nyheter" },
  { href: "utstyr",     label: "Utstyr" },
  { href: "om-klubben", label: "Om klubben" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.includes(`/${href}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1e3a0c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#2e5713" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ås Tennisklubb" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Nyheter – Ås Tennisklubb" href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {languageAlternates?.map(({ href, hrefLang }) => (
      <link rel="alternate" hreflang={hrefLang} href={href} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsClub",
      "name": "Ås Tennisklubb",
      "url": "https://as-tennisklubb.github.io",
      "description": "Ås Tennisklubb – tennis for alle i Ås, siden 1976.",
      "foundingDate": "1976",
      "sport": "Tennis",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Idrettsveien",
        "addressLocality": "Ås",
        "addressCountry": "NO"
      },
      "email": "administrasjon@aastk.no"
    })} />
  </head>

  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 flex flex-col min-h-screen">

    <header class="bg-green-800 dark:bg-green-700 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-20">

        <a href={base} class="flex items-center gap-3 hover:opacity-90 shrink-0" aria-label="Ås Tennisklubb – til forsiden">
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb" class="h-16 w-auto" width="66" height="64" fetchpriority="high" />
          <div class="flex flex-col leading-none">
            <span class="font-bold text-white text-lg tracking-wide">Ås</span>
            <span class="text-green-200 text-xs font-medium tracking-[0.18em] uppercase">Tennisklubb</span>
          </div>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Hovedmeny">
          {navLinks.map(({ href, label }) => (
            <a
              href={`${base}${href}`}
              aria-current={isActive(href) ? "page" : undefined}
              class={`px-3 py-3 rounded-lg transition-colors ${isActive(href) ? "bg-green-700 dark:bg-green-800 font-semibold" : "hover:bg-green-700 dark:hover:bg-green-800"}`}
            >
              {label}
            </a>
          ))}
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class={`ml-2 font-bold px-4 py-2 rounded-full transition-colors min-h-[44px] flex items-center whitespace-nowrap ${isActive("medlemskap") ? "bg-yellow-300 text-gray-900" : "bg-yellow-400 text-gray-900 hover:bg-yellow-300"}`}
          >
            Bli medlem
          </a>
        </nav>

        <!-- Hamburger (§1 §7 §8: synlig mobil, 44px touch target) -->
        <button
          id="menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-green-700 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-label="Åpne meny"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu id="icon-open" class="w-6 h-6" />
          <X   id="icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

      <!-- Mobile meny -->
      <nav
        id="mobile-menu"
        class="hidden border-t border-green-700 dark:border-green-600"
        aria-label="Mobilmeny"
      >

        <div class="px-4 py-3 border-b border-green-700 dark:border-green-600">
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class="flex items-center justify-center min-h-[44px] bg-yellow-400 text-gray-900 font-bold px-4 py-2 rounded-full hover:bg-yellow-300 transition-colors text-sm"
          >
            Bli medlem
          </a>
        </div>
        <ul class="flex flex-col px-4 py-2">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={`${base}${href}`}
                aria-current={isActive(href) ? "page" : undefined}
                class={`flex items-center min-h-[44px] text-sm font-medium transition-colors border-b border-green-700 dark:border-green-600 last:border-0 ${isActive(href) ? "text-yellow-300 font-semibold" : "hover:text-green-300"}`}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      {pageTitle && (
        <section class="bg-green-800 dark:bg-green-700 text-white py-10 md:py-12 px-4">
          <div class="max-w-4xl mx-auto">
            <h1 class="text-3xl md:text-4xl font-bold mb-2">{pageTitle}</h1>
            {pageDescription && (
              <p class="text-green-200 text-base md:text-lg max-w-2xl">{pageDescription}</p>
            )}
          </div>
        </section>
      )}
      <slot />
    </main>

    <footer class="bg-green-900 dark:bg-green-800 text-green-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8">
        <div>
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb" class="h-10 w-auto mb-3" width="41" height="40" />
          <p class="text-sm leading-relaxed">Tennis for alle i Ås, siden 1976.</p>
        </div>
        <nav aria-label="Snarveier">
          <p class="font-semibold text-white mb-3">Lenker</p>
          <ul class="text-sm space-y-2">
            {navLinks.map(({ href, label }) => (
              <li>
                <a href={`${base}${href}`} class="flex items-center min-h-[44px] hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))}
            <li class="pt-1">
              <a href={`${base}medlemskap`} class="inline-flex items-center min-h-[44px] bg-yellow-400 text-gray-900 font-bold px-4 py-2 rounded-full hover:bg-yellow-300 transition-colors text-sm">
                Bli medlem
              </a>
            </li>
          </ul>
        </nav>
        <div>
          <p class="font-semibold text-white mb-3">Kontakt</p>
          <a href="mailto:administrasjon@aastk.no" class="flex items-center min-h-[44px] text-sm hover:text-white transition-colors">administrasjon@aastk.no</a>
          <a
            href={`${base}english`}
            class="inline-flex items-center gap-1 mt-4 text-sm text-green-400 hover:text-white transition-colors min-h-[44px]"
          >
            <Globe class="w-4 h-4" /> English
          </a>
        </div>
      </div>
      <div class="border-t border-green-800 text-center text-xs py-4 text-green-500 flex items-center justify-center gap-3">
        <span>© {new Date().getFullYear()} Ås Tennisklubb</span>
        <span aria-hidden="true">·</span>
        <a href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer" class="hover:text-green-300 transition-colors">Redaktør</a>
      </div>
    </footer>

  </body>
</html>

<script>
  const btn     = document.getElementById("menu-btn");
  const menu    = document.getElementById("mobile-menu");
  const iconOpen  = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });
</script>
