---
import "../styles/global.css";
import { Globe, Menu, X } from "@lucide/astro";
import { ClientRouter, slide } from "astro:transitions";
import HeroSection from "../components/layout/HeroSection.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  pageTitle?: string;
  pageDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  languageAlternates?: Array<{ href: string; hrefLang: string }>;
}

const {
  title = "Ås Tennisklubb",
  description = "Ås Tennisklubb – tennis for alle i Ås",
  lang = "no",
  pageTitle,
  pageDescription,
  ogImage,
  ogImageAlt,
  noindex = false,
  languageAlternates,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: "baner", label: "Spill tennis" },
  { href: "arrangementer", label: "Arrangementer" },
  { href: "kontakt", label: "Kontakt" },
  { href: "om-klubben", label: "Om klubben" },
];

const footerLinks = [
  { href: "baner", label: "Spill tennis" },
  { href: "medlemskap", label: "Bli medlem" },
  { href: "arrangementer", label: "Arrangementer" },
  { href: "nyheter", label: "Nyheter" },
  { href: "utstyr", label: "Utstyr" },
  { href: "om-klubben", label: "Om klubben" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(`/${href}`);
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1e3a0c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#2e5713" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ås Tennisklubb" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nyheter – Ås Tennisklubb"
      href={new URL("rss.xml", Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      languageAlternates?.map(({ href, hrefLang }) => (
        <link rel="alternate" hreflang={hrefLang} href={href} />
      ))
    }
    <ClientRouter />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SportsClub",
        name: "Ås Tennisklubb",
        url: "https://as-tennisklubb.github.io",
        description: "Ås Tennisklubb – tennis for alle i Ås, siden 1976.",
        foundingDate: "1976",
        sport: "Tennis",
        address: {
          "@type": "PostalAddress",
          streetAddress: "Idrettsveien",
          addressLocality: "Ås",
          addressCountry: "NO",
        },
        email: "administrasjon@aastk.no",
      })}
    />
  </head>

  <body
    class="flex min-h-screen flex-col bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100"
  >
    <header
      transition:name="site-header"
      transition:animate="none"
      class="bg-brand-800 text-white shadow-md dark:bg-brand-700"
    >
      <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4">
        <a
          href={base}
          class="flex shrink-0 items-center gap-3 hover:opacity-90"
          aria-label="Ås Tennisklubb – til forsiden"
        >
          <img
            src={`${base}logo.svg`}
            alt="Ås Tennisklubb"
            class="h-16 w-auto"
            width="66"
            height="64"
            fetchpriority="high"
          />
          <div class="flex flex-col leading-none">
            <span class="text-lg font-bold tracking-wide text-white">Ås</span>
            <span class="text-xs font-medium tracking-[0.18em] text-brand-200 uppercase"
              >Tennisklubb</span
            >
          </div>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-1 text-sm font-medium md:flex" aria-label="Hovedmeny">
          {
            navLinks.map(({ href, label }) => (
              <a
                href={`${base}${href}`}
                aria-current={isActive(href) ? "page" : undefined}
                class={`rounded-lg px-3 py-3 transition-colors ${isActive(href) ? "bg-brand-700 font-semibold dark:bg-brand-800" : "hover:bg-brand-700 dark:hover:bg-brand-800"}`}
              >
                {label}
              </a>
            ))
          }
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class={`ml-2 font-bold px-4 py-2 rounded-full transition-colors min-h-[44px] flex items-center whitespace-nowrap ${isActive("medlemskap") ? "bg-accent-600 text-white" : "bg-accent-500 text-white hover:bg-accent-600"}`}
          >
            Bli medlem
          </a>
        </nav>

        <!-- Hamburger (§1 §7 §8: synlig mobil, 44px touch target) -->
        <button
          id="menu-btn"
          class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg p-2 transition-colors hover:bg-brand-700 md:hidden"
          aria-label="Åpne meny"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu id="icon-open" class="h-6 w-6" />
          <X id="icon-close" class="hidden h-6 w-6" />
        </button>
      </div>

      <!-- Mobile meny -->
      <nav
        id="mobile-menu"
        class="hidden border-t border-brand-700 dark:border-brand-600"
        aria-label="Mobilmeny"
      >
        <div class="border-b border-brand-700 px-4 py-3 dark:border-brand-600">
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class="flex min-h-[44px] items-center justify-center rounded-full bg-accent-500 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-accent-600"
          >
            Bli medlem
          </a>
        </div>
        <ul class="flex flex-col px-4 py-2">
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={`${base}${href}`}
                  aria-current={isActive(href) ? "page" : undefined}
                  class={`flex min-h-[44px] items-center border-b border-brand-700 text-sm font-medium transition-colors last:border-0 dark:border-brand-600 ${isActive(href) ? "font-semibold text-yellow-300" : "hover:text-brand-300"}`}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main transition:animate={slide({ duration: "0.3s" })} class="flex-1">
      {pageTitle && <HeroSection size="content" title={pageTitle} description={pageDescription} />}
      <slot />
    </main>

    <footer class="mt-6 bg-brand-900 text-brand-200 dark:bg-brand-800">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
        <div>
          <img
            src={`${base}logo.svg`}
            alt="Ås Tennisklubb"
            class="mb-3 h-10 w-auto"
            width="41"
            height="40"
          />
          <p class="text-sm leading-relaxed">Tennis for alle i Ås, siden 1976.</p>
        </div>
        <nav aria-label="Snarveier">
          <p class="mb-3 font-semibold text-white">Lenker</p>
          <ul class="space-y-2 text-sm">
            {
              footerLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={`${base}${href}`}
                    class="flex min-h-[44px] items-center transition-colors hover:text-white"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <p class="mb-3 font-semibold text-white">Kontakt</p>
          <a
            href={`${base}kontakt`}
            class="flex min-h-[44px] items-center text-sm transition-colors hover:text-white"
            >Se kontaktinformasjon</a
          >
          <a
            href="mailto:administrasjon@aastk.no"
            class="flex min-h-[44px] items-center text-sm transition-colors hover:text-white"
            >administrasjon@aastk.no</a
          >
          <a
            href={`${base}english`}
            class="mt-4 inline-flex min-h-[44px] items-center gap-1 text-sm text-brand-400 transition-colors hover:text-white"
          >
            <Globe class="h-4 w-4" /> English
          </a>
        </div>
      </div>
      <div
        class="flex items-center justify-center gap-3 border-t border-brand-800 py-4 text-center text-xs text-brand-500"
      >
        <span>© {new Date().getFullYear()} Ås Tennisklubb</span>
        <span aria-hidden="true">·</span>
        <a
          href="https://app.pagescms.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-brand-300">Redaktør</a
        >
      </div>
    </footer>
  </body>
</html>

<script>
  function initMenu() {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    btn?.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      menu?.classList.toggle("hidden");
      iconOpen?.classList.toggle("hidden");
      iconClose?.classList.toggle("hidden");
      document.body.classList.toggle("overflow-hidden");
    });
  }

  document.addEventListener("astro:page-load", initMenu);
</script>
