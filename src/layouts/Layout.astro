---
import "../styles/global.css";
import { Globe } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ås Tennisklubb", description = "Ås Tennisklubb – tennis for alle i Ås" } = Astro.props;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: "om-klubben", label: "Om klubben" },
  { href: "baner", label: "Baner" },
  { href: "trening", label: "Trening" },
  { href: "nyheter", label: "Nyheter" },
  { href: "utstyr", label: "Utstyr" },
  { href: "kontakt", label: "Kontakt" },
  { href: "medlemskap", label: "Bli medlem" },
];
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 flex flex-col min-h-screen">

    <header class="bg-green-800 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={base} class="flex items-center gap-3 hover:opacity-90">
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb logo" class="h-12 w-auto" />
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          {navLinks.map(({ href, label }) => (
            <a
              href={`${base}${href}`}
              class="hover:text-yellow-300 transition-colors"
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-green-900 text-green-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-3 gap-8">
        <div>
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb logo" class="h-10 w-auto mb-2" />
          <p class="text-sm">Tennis for alle i Ås, siden 1974.</p>
        </div>
        <div>
          <div class="font-semibold text-white mb-2">Lenker</div>
          <ul class="text-sm space-y-1">
            {navLinks.map(({ href, label }) => (
              <li><a href={`${base}${href}`} class="hover:text-white transition-colors">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="font-semibold text-white mb-2">Kontakt</div>
          <p class="text-sm">post@astennisklubb.no</p>
          <a href={`${base}english`} class="inline-flex items-center gap-1 mt-3 text-xs text-green-400 hover:text-white transition-colors"><Globe class="w-3 h-3" /> English</a>
        </div>
      </div>
      <div class="border-t border-green-800 text-center text-xs py-4 text-green-500">
        © {new Date().getFullYear()} Ås Tennisklubb
      </div>
    </footer>

  </body>
</html>
