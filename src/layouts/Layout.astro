---
/**
 * Layout – Standard layout basert på Aksel-inspirert primitive-system.
 *
 * Body: primitives (Page, PageBlock, HStack, VStack, HGrid, Box).
 * UI:   ui/Button og ui/Link for knapper og lenker.
 */
import "../styles/global.css";
import { Globe, Menu, X } from "@lucide/astro";
import { ClientRouter, slide } from "astro:transitions";
import Page from "../components/primitives/Page.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import HStack from "../components/primitives/HStack.astro";
import VStack from "../components/primitives/VStack.astro";
import HGrid from "../components/primitives/HGrid.astro";
import Box from "../components/primitives/Box.astro";
import WaveDivider from "../components/primitives/WaveDivider.astro";
import Button from "../components/ui/Button.astro";
import Link from "../components/ui/Link.astro";
import Heading from "../components/ui/Heading.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  languageAlternates?: Array<{ href: string; hrefLang: string }>;
}

const {
  title = "Ås Tennisklubb",
  description = "Ås Tennisklubb – tennis for alle i Ås",
  lang = "no",
  ogImage,
  ogImageAlt,
  noindex = false,
  languageAlternates,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: "baner/tennis", label: "Tennis", group: "sport" },
  { href: "baner/padel", label: "Padel", group: "sport" },
  { href: "baner/bordtennis", label: "Bordtennis", group: "sport" },
  { href: "arrangementer", label: "Arrangementer" },
  { href: "nyheter", label: "Nyheter" },
  { href: "om-klubben", label: "Om klubben" },
];

const footerLinks = [
  { href: "baner/tennis", label: "Tennis" },
  { href: "baner/padel", label: "Padel" },
  { href: "baner/bordtennis", label: "Bordtennis" },
  { href: "medlemskap", label: "Bli medlem" },
  { href: "arrangementer", label: "Arrangementer" },
  { href: "nyheter", label: "Nyheter" },
  { href: "om-klubben", label: "Om klubben" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(`/${href}`);
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1e3a0c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#2e5713" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ås Tennisklubb" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nyheter – Ås Tennisklubb"
      href={new URL("rss.xml", Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      languageAlternates?.map(({ href, hrefLang }) => (
        <link rel="alternate" hreflang={hrefLang} href={href} />
      ))
    }
    <ClientRouter />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SportsClub",
        name: "Ås Tennisklubb",
        url: "https://as-tennisklubb.github.io",
        description: "Ås Tennisklubb – tennis for alle i Ås, siden 1976.",
        foundingDate: "1976",
        sport: "Tennis",
        address: {
          "@type": "PostalAddress",
          streetAddress: "Idrettsveien",
          addressLocality: "Ås",
          addressCountry: "NO",
        },
        email: "administrasjon@aastk.no",
      })}
    />
  </head>

  <body class="bg-vignette bg-gray-100 text-[var(--aastk-text-default)] dark:bg-gray-950">
    <Page>
      {/* ───── Header ───── */}
      <header
        transition:name="site-header"
        transition:animate="none"
        class="relative z-10 bg-gray-900 text-white md:bg-transparent"
      >
        <PageBlock width="2xl" gutters class="h-24">
          <HStack align="center" justify="space-between" class="h-full">
            <Link
              href={base}
              underline={false}
              class="flex shrink-0 items-center gap-3 hover:opacity-90"
              aria-label="Ås Tennisklubb – til forsiden"
            >
              <img
                src={`${base}logo.svg`}
                alt="Ås Tennisklubb"
                class="h-20 w-auto"
                width="82"
                height="80"
                fetchpriority="high"
              />
              <VStack class="leading-none">
                <span class="text-xl font-bold tracking-wide text-white">Ås</span>
                <span
                  class="text-sm font-medium tracking-[0.18em] text-[var(--aastk-text-on-brand-muted)] uppercase"
                >
                  Tennisklubb
                </span>
              </VStack>
            </Link>

            {/* Desktop nav */}
            <HStack
              as="nav"
              gap="1"
              align="center"
              class="hidden text-sm font-medium md:flex"
              aria-label="Hovedmeny"
            >
              {
                navLinks.map(({ href, label, group }, i) => {
                  const prev = navLinks[i - 1];
                  const showDivider = i > 0 && prev?.group === "sport" && group !== "sport";
                  return (
                    <>
                      {showDivider && <span class="mx-1 h-5 w-px bg-white/25" aria-hidden="true" />}
                      <a
                        href={`${base}${href}`}
                        aria-current={isActive(href) ? "page" : undefined}
                        class={`rounded-lg px-3 py-3 text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white ${isActive(href) ? "bg-white/15 hover:bg-white/20" : "hover:bg-white/10"}`}
                      >
                        {label}
                      </a>
                    </>
                  );
                })
              }
              <Button
                href={`${base}medlemskap`}
                variant="primary"
                size="small"
                aria-current={isActive("medlemskap") ? "page" : undefined}
                class={`ml-2 whitespace-nowrap rounded-full ${isActive("medlemskap") ? "bg-accent-600" : "bg-accent-500 hover:bg-accent-600 active:bg-accent-700"}`}
              >
                Bli medlem
              </Button>
            </HStack>

            {/* Hamburger */}
            <button
              id="menu-btn"
              class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg p-2 transition-colors hover:bg-[var(--aastk-surface-inverted-hover)] md:hidden"
              aria-label="Åpne meny"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <Menu id="icon-open" class="h-6 w-6" />
              <X id="icon-close" class="hidden h-6 w-6" />
            </button>
          </HStack>
        </PageBlock>

        {/* Mobilmeny */}
        <nav
          id="mobile-menu"
          class="hidden border-t [border-color:var(--aastk-border-inverted)]"
          aria-label="Mobilmeny"
        >
          <Box
            paddingInline="4"
            paddingBlock="3"
            class="border-b [border-color:var(--aastk-border-inverted)]"
          >
            <Button
              href={`${base}medlemskap`}
              variant="primary"
              size="small"
              aria-current={isActive("medlemskap") ? "page" : undefined}
              class="w-full justify-center rounded-full bg-accent-500 hover:bg-accent-600"
            >
              Bli medlem
            </Button>
          </Box>
          <VStack as="ul" paddingInline="4" paddingBlock="2">
            {
              navLinks.map(({ href, label, group }, i) => {
                const prev = navLinks[i - 1];
                const showDivider = i > 0 && prev?.group === "sport" && group !== "sport";
                return (
                  <>
                    {showDivider && (
                      <li
                        aria-hidden="true"
                        class="my-1 border-b [border-color:var(--aastk-border-inverted)]"
                      />
                    )}
                    <li>
                      <Link
                        href={`${base}${href}`}
                        underline={false}
                        aria-current={isActive(href) ? "page" : undefined}
                        class={`flex min-h-[44px] items-center border-b [border-color:var(--aastk-border-inverted)] text-sm font-medium last:border-0 ${isActive(href) ? "font-semibold text-yellow-300" : "text-[var(--aastk-text-on-brand-muted)] hover:text-white"}`}
                      >
                        {label}
                      </Link>
                    </li>
                  </>
                );
              })
            }
          </VStack>
        </nav>
      </header>

      {/* ───── Main ───── */}
      <main transition:animate={slide({ duration: "0.3s" })} class="flex-1">
        <slot />
      </main>

      {/* ───── Footer ───── */}
      <WaveDivider color="var(--aastk-surface-inverted-active)" flip class="-mb-px" />
      <Box
        as="footer"
        class="bg-[var(--aastk-surface-inverted-active)] text-[var(--aastk-text-on-brand-muted)]"
      >
        <PageBlock width="2xl" gutters>
          <Box paddingBlock="10">
            <HGrid columns={{ sm: 1, md: 3 }} gap="8">
              {/* Kolonne 1: Brand-blokk */}
              <VStack gap="3">
                <HStack gap="3" align="center">
                  <img
                    src={`${base}logo.svg`}
                    alt=""
                    class="h-10 w-auto shrink-0"
                    width="41"
                    height="40"
                  />
                  <Heading level={3} size="xsmall" class="text-white">Ås Tennisklubb</Heading>
                </HStack>
                <p class="text-sm leading-relaxed">Racketsport for alle i Ås.</p>
              </VStack>

              {/* Kolonne 2: Lenker */}
              <nav aria-label="Snarveier">
                <VStack gap="2">
                  <Heading level={3} size="xsmall" class="text-white">Lenker</Heading>
                  <VStack as="ul" gap="2" class="text-sm">
                    {
                      footerLinks.map(({ href, label }) => (
                        <li>
                          <Link
                            href={`${base}${href}`}
                            underline={false}
                            dataColor="subtle"
                            class="flex min-h-[44px] items-center text-[var(--aastk-text-on-brand-muted)] hover:text-white"
                          >
                            {label}
                          </Link>
                        </li>
                      ))
                    }
                  </VStack>
                </VStack>
              </nav>

              {/* Kolonne 3: Kontakt */}
              <VStack gap="3">
                <Heading level={3} size="xsmall" class="text-white">Kontakt</Heading>
                <Link
                  href={`${base}kontakt`}
                  underline={false}
                  dataColor="subtle"
                  class="flex min-h-[44px] items-center text-sm text-[var(--aastk-text-on-brand-muted)] hover:text-white"
                >
                  Se kontaktinformasjon
                </Link>
                <Link
                  href="mailto:administrasjon@aastk.no"
                  underline={false}
                  dataColor="subtle"
                  class="flex min-h-[44px] items-center text-sm text-[var(--aastk-text-on-brand-muted)] hover:text-white"
                >
                  administrasjon@aastk.no
                </Link>
                <Link
                  href={`${base}english`}
                  underline={false}
                  dataColor="subtle"
                  class="min-h-[44px] text-sm text-[var(--aastk-text-on-brand-muted)] hover:text-white"
                >
                  <Globe class="h-4 w-4" /> English
                </Link>
              </VStack>
            </HGrid>
          </Box>
        </PageBlock>

        <Box
          class="border-t [border-color:var(--aastk-border-inverted)] text-center text-xs text-[var(--aastk-text-on-brand-muted)]"
        >
          <HStack justify="center" align="center" gap="3" paddingBlock="4">
            <span>© {new Date().getFullYear()} Ås Tennisklubb</span>
            <span aria-hidden="true">·</span>
            <Link
              href="https://app.pagescms.org/"
              target="_blank"
              rel="noopener noreferrer"
              underline={false}
              dataColor="subtle"
              class="text-[var(--aastk-text-on-brand-muted)] hover:text-white"
            >
              Redaktør
            </Link>
          </HStack>
        </Box>
      </Box>
    </Page>
  </body>
</html>

<script>
  function initMenu() {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    // Reset menu state on page load (handles View Transitions)
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");

    btn?.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      menu?.classList.toggle("hidden");
      iconOpen?.classList.toggle("hidden");
      iconClose?.classList.toggle("hidden");
      document.body.classList.toggle("overflow-hidden");
    });
  }

  document.addEventListener("astro:page-load", initMenu);
</script>
