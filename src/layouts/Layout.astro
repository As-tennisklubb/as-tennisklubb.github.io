---
import "../styles/global.css";
import { Globe, Menu, X } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ås Tennisklubb", description = "Ås Tennisklubb – tennis for alle i Ås" } = Astro.props;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: "trening",    label: "Trening" },
  { href: "baner",      label: "Baner" },
  { href: "nyheter",    label: "Nyheter" },
  { href: "utstyr",     label: "Utstyr" },
  { href: "om-klubben", label: "Om klubben" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.includes(`/${href}`);
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 flex flex-col min-h-screen">

    <header class="bg-green-800 dark:bg-green-950 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">

        <a href={base} class="hover:opacity-90 shrink-0" aria-label="Ås Tennisklubb – til forsiden">
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb" class="h-12 w-auto" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Hovedmeny">
          {navLinks.map(({ href, label }) => (
            <a
              href={`${base}${href}`}
              aria-current={isActive(href) ? "page" : undefined}
              class={`px-3 py-3 rounded-lg transition-colors ${isActive(href) ? "bg-green-700 dark:bg-green-800 font-semibold" : "hover:bg-green-700 dark:hover:bg-green-900"}`}
            >
              {label}
            </a>
          ))}
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class={`ml-2 font-bold px-4 py-2 rounded-full transition-colors min-h-[44px] flex items-center whitespace-nowrap ${isActive("medlemskap") ? "bg-yellow-300 text-gray-900" : "bg-yellow-400 text-gray-900 hover:bg-yellow-300"}`}
          >
            Bli medlem
          </a>
        </nav>

        <!-- Hamburger (§1 §7 §8: synlig mobil, 44px touch target) -->
        <button
          id="menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-green-700 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-label="Åpne meny"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu id="icon-open" class="w-6 h-6" />
          <X   id="icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

      <!-- Mobile meny -->
      <nav
        id="mobile-menu"
        class="hidden border-t border-green-700 dark:border-green-900"
        aria-label="Mobilmeny"
      >
        <div class="px-4 py-3 border-b border-green-700 dark:border-green-900">
          <a
            href={`${base}medlemskap`}
            aria-current={isActive("medlemskap") ? "page" : undefined}
            class="flex items-center justify-center min-h-[44px] bg-yellow-400 text-gray-900 font-bold px-4 py-2 rounded-full hover:bg-yellow-300 transition-colors text-sm"
          >
            Bli medlem
          </a>
        </div>
        <ul class="flex flex-col px-4 py-2">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={`${base}${href}`}
                aria-current={isActive(href) ? "page" : undefined}
                class={`flex items-center min-h-[44px] text-sm font-medium transition-colors border-b border-green-700 dark:border-green-900 last:border-0 ${isActive(href) ? "text-yellow-300 font-semibold" : "hover:text-green-300"}`}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-green-900 dark:bg-green-950 text-green-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8">
        <div>
          <img src={`${base}logo.svg`} alt="Ås Tennisklubb" class="h-10 w-auto mb-3" />
          <p class="text-sm leading-relaxed">Tennis for alle i Ås, siden 1974.</p>
        </div>
        <nav aria-label="Snarveier">
          <p class="font-semibold text-white mb-3">Lenker</p>
          <ul class="text-sm space-y-2">
            {navLinks.map(({ href, label }) => (
              <li>
                <a href={`${base}${href}`} class="hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div>
          <p class="font-semibold text-white mb-3">Kontakt</p>
          <a href="mailto:administrasjon@aastk.no" class="text-sm hover:text-white transition-colors">administrasjon@aastk.no</a>
          <a
            href={`${base}english`}
            class="inline-flex items-center gap-1 mt-4 text-xs text-green-400 hover:text-white transition-colors min-h-[44px]"
          >
            <Globe class="w-3 h-3" /> English
          </a>
        </div>
      </div>
      <div class="border-t border-green-800 text-center text-xs py-4 text-green-500">
        © {new Date().getFullYear()} Ås Tennisklubb
      </div>
    </footer>

  </body>
</html>

<script>
  const btn     = document.getElementById("menu-btn");
  const menu    = document.getElementById("mobile-menu");
  const iconOpen  = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });
</script>
