---
import Layout from "../layouts/Layout.astro";
import { UserPlus } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import BulletList from "../components/ui/BulletList.astro";
import ResponsiveDataList from "../components/content/ResponsiveDataList.astro";

const base = import.meta.env.BASE_URL;

const priser = [
  { type: "Barn/junior (inntil 19 år)", pris: "500,-" },
  { type: "Student / vernepliktig", pris: "700,-" },
  { type: "Voksen", pris: "1 200,-" },
  { type: "Familiemedlemskap", pris: "2 100,-" },
];
---

<Layout
  title="Medlemskap – Ås Tennisklubb"
  description="Bli medlem av Ås Tennisklubb. Se priser, betalingsinfo og prøvespill."
  pageTitle="Medlemskap"
  pageDescription="Alle er velkomne – uansett alder, kjønn og nivå."
>
  <Container padded>
    <!-- Registrer nytt medlemskap -->
    <PageSection title="Registrer nytt medlemskap" icon={UserPlus}>
      <p class="mb-6 text-sm text-gray-700 dark:text-gray-300">
        Innmelding skjer via Min Idrett. Du registrerer deg i ny fane – det tar bare noen minutter.
      </p>
      <Button href="https://medlemskap.nif.no/19967" target="_blank" rel="noopener noreferrer">
        Meld deg inn på Min Idrett →
      </Button>
    </PageSection>

    <!-- Prisliste -->
    <PageSection title="Medlemskontingent 2025">
      <ResponsiveDataList>
        <Fragment slot="mobile">
          {
            priser.map(({ type, pris }) => (
              <div class="data-card flex items-center justify-between">
                <span class="text-sm text-gray-700 dark:text-gray-300">{type}</span>
                <span class="font-bold text-brand-700 dark:text-brand-400">kr {pris}</span>
              </div>
            ))
          }
        </Fragment>
        <Fragment slot="desktop">
          <table class="data-table">
            <thead>
              <tr>
                <th>Medlemstype</th>
                <th class="text-right">Pris</th>
              </tr>
            </thead>
            <tbody>
              {
                priser.map(({ type, pris }) => (
                  <tr>
                    <td class="font-medium text-gray-900 dark:text-gray-100">{type}</td>
                    <td class="text-right font-semibold text-brand-700 dark:text-brand-400">
                      kr {pris}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </Fragment>
      </ResponsiveDataList>
    </PageSection>

    <!-- Betaling -->
    <PageSection title="Betaling">
      <Callout class="space-y-2">
        <p>
          Betal via <strong class="text-gray-900 dark:text-gray-100"
            >kontonummer 1100 44 76109</strong
          > eller <strong class="text-gray-900 dark:text-gray-100"
            >Vipps til Ås Tennisklubb #14506</strong
          >.
        </p>
        <p>Merk betalingen med: <em>Navn, og type medlemskap</em>.</p>
        <p class="pt-2">
          Send deretter e-post til
          <a href="mailto:aas.tbk@gmail.com" class="link">aas.tbk@gmail.com</a>
          med navn og mobilnummer for de som skal ha tilgang.
          <br />
          <span class="text-xs text-gray-500 dark:text-gray-500"
            >Medlemmer fra i fjor med Yale Home App-tilgang trenger ikke sende mail.</span
          >
        </p>
      </Callout>
    </PageSection>

    <!-- Adgang -->
    <PageSection title="Tilgang til bane og klubbhus">
      <RichTextBlock>
        <p>
          Alle betalende medlemmer får tilgang til anlegget via <strong>Yale Home-appen</strong>.
          Tilgangen aktiveres etter at kontingenten er betalt og vi har mottatt navn og mobilnummer.
        </p>
      </RichTextBlock>
    </PageSection>

    <!-- Prøvespill -->
    <PageSection title="Prøvespill">
      <RichTextBlock class="mb-4">
        <p>
          Spillere som ikke er medlemmer er hjertelig velkomne til prøvespill. For at ordningen ikke
          skal misbrukes gjelder følgende regler:
        </p>
      </RichTextBlock>
      <BulletList
        items={[
          "Prøvespill gjelder kun én gang per person.",
          "Baneleie for prøvespill er kr 200,- for 1 time. Beløpet refunderes ved tegning av medlemskap.",
          "Betal til konto 1100 44 76109 eller Vipps Ås Tennisklubb #14506.",
          "Send mail til im@aastk.no med mobilnummer – du får tilgang via Yale Home-appen.",
        ]}
        class="mb-6"
      />
      <Button variant="outline" href="mailto:im@aastk.no" class="text-sm">
        Send mail for prøvespill →
      </Button>
    </PageSection>
  </Container>
</Layout>
