---
import Layout from "../layouts/Layout.astro";
import { UserPlus } from "@lucide/astro";
import Button from "../components/ui/Button.astro";
import Link from "../components/ui/Link.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";
import HGrid from "../components/primitives/HGrid.astro";
import DataTable from "../components/ui/DataTable.astro";
import Process from "../components/ui/Process.astro";
import ProcessEvent from "../components/ui/ProcessEvent.astro";
import InfoCard from "../components/ui/InfoCard.astro";
import List from "../components/ui/List.astro";
import ListItem from "../components/ui/ListItem.astro";

const base = import.meta.env.BASE_URL;

const priser = [
  { type: "Barn/junior (inntil 19 år)", pris: "500,-" },
  { type: "Student / vernepliktig", pris: "700,-" },
  { type: "Voksen", pris: "1 200,-" },
  { type: "Familiemedlemskap", pris: "2 100,-" },
];
---

<Layout
  title="Medlemskap – Ås Tennisklubb"
  description="Bli medlem av Ås Tennisklubb – se priser, fordeler og betalingsinfo."
>
  {/* ───── Toppseksjon ───── */}
  <PageHeader title="Medlemskap" description="Alle er velkomne – uansett alder, kjønn og nivå." />

  {/* ───── Sideinnhold ───── */}
  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* Hva får du som medlem */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Hva får du som medlem?</Heading>
          <BodyLong
            >Medlemskapet gir deg tilgang til alle klubbens idretter og aktiviteter.</BodyLong
          >
          <List as="ul" size="small">
            <ListItem>Spill tennis på tre grusbaner fra april til november.</ListItem>
            <ListItem>Spill bordtennis innendørs på Holstad skole – hele året.</ListItem>
            <ListItem>Bruk to utendørs padelbaner fritt i sommerhalvåret.</ListItem>
            <ListItem>Lån racketer og baller gratis i klubbhuset.</ListItem>
            <ListItem
              >Delta i kurs, turneringer og sosiale samlinger – fra nybegynnerkurs til
              klubbmesterskap.</ListItem
            >
            <ListItem
              >Et inkluderende miljø der barn, voksne og seniorer spiller side om side.</ListItem
            >
          </List>
        </VStack>
      </PageBlock>
    </section>

    {/* Priser og betaling */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Medlemskontingent 2026</Heading>
          <HGrid columns={{ sm: 1, md: 2 }} gap="8" class="md:grid-cols-[3fr_2fr]">
            <DataTable
              rows={priser.map(({ type, pris }) => ({ label: type, value: `kr ${pris}` }))}
              labelHeader="Medlemstype"
              valueHeader="Pris"
            />
            <InfoCard dataColor="brand" title="Betaling">
              <p>
                Betal til <strong class="text-heading">konto 1100 44 76109</strong> eller
                <strong class="text-heading">Vipps Ås Tennisklubb #14506</strong>. Merk med <em
                  >Navn og type medlemskap</em
                >.
              </p>
              <p>Du får også tilgang til banebooking og klubbhus via Yale Home-appen.</p>
            </InfoCard>
          </HGrid>
          <BodyLong size="small" class="text-muted">
            Familiemedlemskap gjelder for alle i samme husstand.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Ny medlem */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <HStack gap="3" align="center">
            <UserPlus class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Kom i gang</Heading>
          </HStack>
          <BodyLong>Det tar bare noen minutter å bli medlem. Slik gjør du:</BodyLong>
          <Process>
            <ProcessEvent title="Registrer deg" status="active">
              <Fragment slot="bullet">1</Fragment>
              <p>Opprett profil via Min Idrett.</p>
              <div>
                <Button
                  href="https://medlemskap.nif.no/19967"
                  size="small"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Registrer på Min Idrett →
                </Button>
              </div>
            </ProcessEvent>
            <ProcessEvent title="Betal kontingent">
              <Fragment slot="bullet">2</Fragment>
              Betal via konto eller Vipps – se betalingsinfo over.
            </ProcessEvent>
            <ProcessEvent title="Få tilgang">
              <Fragment slot="bullet">3</Fragment>
              <p>
                Send navn og e-mail adresse til <Link href="mailto:aas.tbk@gmail.com" inlineText
                  >aas.tbk@gmail.com</Link
                >, så gir vi deg tilgang via <strong>Yale Home-appen</strong>.
              </p>
            </ProcessEvent>
          </Process>
        </VStack>
      </PageBlock>
    </section>

    {/* Forny medlemskap */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="2">
          <Heading level={2} size="small" dataColor="brand">Forny medlemskap</Heading>
          <BodyLong size="small">
            Allerede medlem? Betal kontingent for å fornye – Yale Home-tilgangen oppdateres
            automatisk.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
