---
import Layout from "../layouts/Layout.astro";
import { UserPlus, RefreshCw } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import ResponsiveDataList from "../components/content/ResponsiveDataList.astro";
import StepList from "../components/content/StepList.astro";

const priser = [
  { type: "Barn/junior (inntil 19 år)", pris: "500,-" },
  { type: "Student / vernepliktig", pris: "700,-" },
  { type: "Voksen", pris: "1 200,-" },
  { type: "Familiemedlemskap", pris: "2 100,-" },
];
---

<Layout
  title="Medlemskap – Ås Tennisklubb"
  description="Bli medlem av Ås Tennisklubb. Se priser, betalingsinfo og prøvespill."
  pageTitle="Medlemskap"
  pageDescription="Alle er velkomne – uansett alder, kjønn og nivå."
>
  <Container padded>
    <RichTextBlock class="mb-4">
      <p>Er du ny eller allerede medlem? Finn din vei videre.</p>
    </RichTextBlock>

    <!-- Prisliste -->
    <PageSection title="Medlemskontingent 2026">
      <ResponsiveDataList>
        <Fragment slot="mobile">
          {
            priser.map(({ type, pris }) => (
              <div class="data-card flex items-center justify-between">
                <span class="text-sm text-gray-700 dark:text-gray-300">{type}</span>
                <span class="font-bold text-brand-700 dark:text-brand-400">kr {pris}</span>
              </div>
            ))
          }
        </Fragment>
        <Fragment slot="desktop">
          <table class="data-table">
            <thead>
              <tr>
                <th>Medlemstype</th>
                <th class="text-right">Pris</th>
              </tr>
            </thead>
            <tbody>
              {
                priser.map(({ type, pris }) => (
                  <tr>
                    <td class="font-medium text-gray-900 dark:text-gray-100">{type}</td>
                    <td class="text-right font-semibold text-brand-700 dark:text-brand-400">
                      kr {pris}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </Fragment>
      </ResponsiveDataList>
    </PageSection>

    <!-- Betaling -->
    <PageSection title="Betaling">
      <Callout variant="success" class="space-y-2">
        <p class="font-semibold text-gray-900 dark:text-gray-100">Betal slik:</p>
        <p>
          Betal til <strong class="text-gray-900 dark:text-gray-100">konto 1100 44 76109</strong> eller
          <strong class="text-gray-900 dark:text-gray-100">Vipps Ås Tennisklubb #14506</strong>.
          Merk med <em>Navn og type medlemskap</em>.
        </p>
        <p>Betaling gir full tilgang til banebooking og klubbhus.</p>
      </Callout>
    </PageSection>

    <!-- Ny medlem -->
    <PageSection title="Ny medlem" icon={UserPlus}>
      <StepList
        steps={[
          {
            title: "Registrer deg",
            text: "Opprett profil via Min Idrett – det tar bare noen minutter.",
          },
          {
            title: "Betal kontingent",
            text: "Se betalingsinformasjon over.",
          },
        ]}
        class="md:grid-cols-2"
      />
      <Button
        href="https://medlemskap.nif.no/19967"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 text-sm"
      >
        Registrer på Min Idrett →
      </Button>
      <RichTextBlock class="mt-6">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Etter betaling får du tilgang via <strong>Yale Home-appen</strong>.
          Send e-post til <a href="mailto:aas.tbk@gmail.com" class="link">aas.tbk@gmail.com</a> med navn og mobilnummer for alle som skal ha tilgang.
        </p>
      </RichTextBlock>
    </PageSection>

    <!-- Eksisterende medlem -->
    <PageSection title="Allerede medlem?" icon={RefreshCw}>
      <RichTextBlock>
        <p>
          Du trenger ikke registrere deg på nytt – betal kontingent for å fornye.
        </p>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">
          Har du Yale Home-tilgang fra i fjor? Tilgangen fornyes automatisk etter betaling.
        </p>
      </RichTextBlock>
    </PageSection>
  </Container>
</Layout>
