---
import Layout from "../layouts/Layout.astro";
import { UserPlus, RefreshCw } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import ResponsiveDataList from "../components/content/ResponsiveDataList.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Card from "../components/ui/Card.astro";

const base = import.meta.env.BASE_URL;

const priser = [
  { type: "Barn/junior (inntil 19 år)", pris: "500,-" },
  { type: "Student / vernepliktig", pris: "700,-" },
  { type: "Voksen", pris: "1 200,-" },
  { type: "Familiemedlemskap", pris: "2 100,-" },
];
---

<Layout
  title="Medlemskap – Ås Tennisklubb"
  description="Bli medlem av Ås Tennisklubb. Se priser, betalingsinfo og prøvespill."
  pageTitle="Medlemskap"
  pageDescription="Alle er velkomne – uansett alder, kjønn og nivå."
>
  <Container padded>
    <!-- Prisliste -->
    <PageSection title="Medlemskontingent 2026">
      <ResponsiveDataList>
        <Fragment slot="mobile">
          {
            priser.map(({ type, pris }) => (
              <div class="data-card flex items-center justify-between">
                <span class="text-sm text-gray-700 dark:text-gray-300">{type}</span>
                <span class="font-bold text-brand-700 dark:text-brand-400">kr {pris}</span>
              </div>
            ))
          }
        </Fragment>
        <Fragment slot="desktop">
          <table class="data-table">
            <thead>
              <tr>
                <th>Medlemstype</th>
                <th class="text-right">Pris</th>
              </tr>
            </thead>
            <tbody>
              {
                priser.map(({ type, pris }) => (
                  <tr>
                    <td class="font-medium text-gray-900 dark:text-gray-100">{type}</td>
                    <td class="text-right font-semibold text-brand-700 dark:text-brand-400">
                      kr {pris}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </Fragment>
      </ResponsiveDataList>
    </PageSection>

    <!-- Ny medlem -->
    <PageSection title="Ny medlem" icon={UserPlus}>
      <RichTextBlock class="mb-4">
        <p>Har du ikke vært medlem før? Følg disse stegene:</p>
      </RichTextBlock>
      <CardGrid cols={2}>
        <Card>
          <p
            class="mb-1 text-xs font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-400"
          >
            Steg 1
          </p>
          <h3 class="mb-2 font-semibold text-gray-900 dark:text-gray-100">Registrer deg</h3>
          <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
            Opprett profil via Min Idrett – det tar bare noen minutter.
          </p>
          <Button
            href="https://medlemskap.nif.no/19967"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm"
          >
            Registrer på Min Idrett →
          </Button>
        </Card>
        <Card>
          <p
            class="mb-1 text-xs font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-400"
          >
            Steg 2
          </p>
          <h3 class="mb-2 font-semibold text-gray-900 dark:text-gray-100">Betal og få tilgang</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Betal kontingent til
            <strong class="text-gray-900 dark:text-gray-100">konto 1100 44 76109</strong> eller
            <strong class="text-gray-900 dark:text-gray-100">Vipps Ås Tennisklubb #14506</strong>.
            Merk med <em>Navn og type medlemskap</em>.
          </p>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Send e-post til
            <a href="mailto:aas.tbk@gmail.com" class="link">aas.tbk@gmail.com</a>
            med navn og mobilnummer for alle som skal ha tilgang.
          </p>
        </Card>
      </CardGrid>
      <Callout class="mt-6">
        Etter at betalingen er registrert får du tilgang til bane og klubbhus via <strong
          >Yale Home-appen</strong
        >.
      </Callout>
    </PageSection>

    <!-- Eksisterende medlem -->
    <PageSection title="Allerede medlem?" icon={RefreshCw}>
      <RichTextBlock class="mb-4">
        <p>
          Forny medlemskapet ditt ved å betale kontingent – du trenger ikke registrere deg på nytt.
        </p>
      </RichTextBlock>
      <Callout class="space-y-2">
        <p>
          Betal til <strong class="text-gray-900 dark:text-gray-100">konto 1100 44 76109</strong> eller
          <strong class="text-gray-900 dark:text-gray-100">Vipps Ås Tennisklubb #14506</strong>.
          Merk med <em>Navn og type medlemskap</em>.
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500">
          Har du Yale Home-tilgang fra i fjor? Da trenger du ikke sende e-post – tilgangen fornyes
          automatisk etter betaling.
        </p>
      </Callout>
    </PageSection>
  </Container>
</Layout>
