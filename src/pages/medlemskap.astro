---
import Layout from "../layouts/Layout.astro";
import { UserPlus } from "@lucide/astro";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";
import DataTable from "../components/ui/DataTable.astro";
import Process from "../components/ui/Process.astro";
import ProcessEvent from "../components/ui/ProcessEvent.astro";
import InfoCard from "../components/ui/InfoCard.astro";
import List from "../components/ui/List.astro";
import ListItem from "../components/ui/ListItem.astro";

const priser = [
  { type: "Barn/junior (inntil 19 år)", pris: "500,-" },
  { type: "Student / vernepliktig", pris: "700,-" },
  { type: "Voksen", pris: "1 200,-" },
  { type: "Familiemedlemskap (alle i samme husstand)", pris: "2 100,-" },
];
---

<Layout
  title="Medlemskap – Ås Tennisklubb"
  description="Bli medlem av Ås Tennisklubb – se priser, fordeler og betalingsinfo."
  heroLayout
>
  <PageHeader
    title="Medlemskap"
    description="Alle er velkomne – uansett alder, kjønn og nivå."
    heroCategory="tennis"
  />

  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand"> Hva får du som medlem? </Heading>

          <BodyLong>
            Medlemskapet gir deg tilgang til alle klubbens idretter og aktiviteter.
          </BodyLong>

          <List as="ul" size="small">
            <ListItem>Spill tennis på tre grusbaner fra april til november.</ListItem>
            <ListItem>Spill bordtennis innendørs på Gamle Holstad skole – hele året.</ListItem>
            <ListItem>Bruk to utendørs padelbaner fritt i sommerhalvåret.</ListItem>
            <ListItem>Lån racketer og baller gratis i klubbhuset.</ListItem>
            <ListItem>
              Delta i kurs, turneringer og sosiale samlinger – fra nybegynnerkurs til
              klubbmesterskap.
            </ListItem>
            <ListItem>
              Et inkluderende miljø der barn, voksne og seniorer spiller side om side.
            </ListItem>
          </List>
        </VStack>
      </PageBlock>
    </section>

    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand"> Medlemskontingent 2026 </Heading>

          <DataTable
            rows={priser.map(({ type, pris }) => ({
              label: type,
              value: `kr ${pris}`,
            }))}
            labelHeader="Medlemstype"
            valueHeader="Pris"
          />

          <InfoCard dataColor="brand" title="Om medlemsavgiften">
            <VStack gap="3">
              <p>
                Ås Tennisklubb er en dugnadsbasert idrettsklubb, og medlemskapet gjelder for
                kalenderåret (1. januar–31. desember). Medlemsavgiften er den samme uavhengig av når
                i året du melder deg inn.
              </p>

              <p>
                Studentmedlemskapet har en lavere pris fordi mange studenter først blir aktive i
                høstsemesteret.
              </p>

              <p>
                Medlemskapet bidrar til drift og utvikling av klubben, og inkluderer blant annet fri
                tilgang til bordtennis hele året.
              </p>

              <p>
                Dersom økonomi er til hinder for at et barn eller en ungdom under 19 år kan delta,
                ber vi dere ta kontakt med oss på <strong>leder@aastk.no</strong>. Vi behandler alle
                henvendelser konfidensielt.
              </p>

              <p>Vi ønsker at alle skal ha mulighet til å være en del av Ås Tennisklubb.</p>
            </VStack>
          </InfoCard>

          <InfoCard dataColor="brand" title="Betaling">
            <VStack gap="3">
              <div>
                <strong class="text-heading">Vipps</strong><br />
                #14506 – Ås Tennisklubb
              </div>

              <div>
                <strong class="text-heading">Konto</strong><br />
                1100 44 76109
              </div>

              <div class="text-muted text-sm">
                Merk betalingen med navn og type medlemskap. Ved familiemedlemskap: skriv navn på
                alle i familien.
              </div>
            </VStack>
          </InfoCard>
        </VStack>
      </PageBlock>
    </section>

    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <HStack gap="3" align="center">
            <UserPlus class="size-6 text-[var(--aastk-text-brand)]" />

            <Heading level={2} size="medium" dataColor="brand"> Slik blir du medlem </Heading>
          </HStack>

          <Process>
            <ProcessEvent title="Betal kontingenten" status="active">
              <Fragment slot="bullet">1</Fragment>

              <p>
                Betal medlemskontingenten med Vipps eller bankoverføring, se betalingsinformasjon
                over.
              </p>
            </ProcessEvent>

            <ProcessEvent title="Meld deg inn i Min idrett">
              <Fragment slot="bullet">2</Fragment>

              <p>Innmelding i Min idrett er obligatorisk for alle medlemmer.</p>

              <p>For familiemedlemskap må alle familiemedlemmer meldes inn individuelt.</p>

              <div>
                <Button
                  href="https://www.minidrett.no/medlemskap/19967"
                  size="small"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Meld deg inn i Min idrett →
                </Button>
              </div>
            </ProcessEvent>

            <ProcessEvent title="Få banetilgang">
              <Fragment slot="bullet">3</Fragment>

              <p>
                Når både betaling og innmelding er registrert for alle, får du tilgang til banene
                via <strong>Yale Home-appen</strong>.
              </p>
            </ProcessEvent>
          </Process>

          <BodyLong size="small"> Velkommen til spill! </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="2">
          <Heading level={2} size="small" dataColor="brand"> Forny medlemskap </Heading>

          <BodyLong size="small">
            Allerede medlem? Betal kontingent for å fornye medlemskapet.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
