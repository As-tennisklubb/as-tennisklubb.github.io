---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import RuleList from "../components/content/RuleList.astro";
import LazyMap from "../components/content/LazyMap.astro";
import BulletList from "../components/ui/BulletList.astro";

const base = import.meta.env.BASE_URL;

const reglement = [
  "Banene må vannes før bruk når grusen er tørr.",
  "Banene kan benyttes mellom kl. 07.00 og 22.30.",
  "Hver spiller kan bestille én bane per dag.",
  "Kanseller bestillingen i god tid hvis du ikke kan spille.",
  "Kost banen etter bruk – start ytterst langs gjerdet og jobb deg innover.",
  "Bruk sko med jevn såle – grov såle ødelegger grusen.",
  "Banen er spillbar så lenge det ikke står vann på den.",
  "Dersom en linje løsner, vann den og bank den ned med stamperen.",
  "Kast søppel, flasker og tomme ballrør i søppelkassene.",
  "Den som forlater anlegget sist, slår av lyset og låser port og klubbhus.",
  "Kontakt klubben dersom du oppdager feil på banene.",
];
---

<Layout
  title="Baner – Ås Tennisklubb"
  description="Ås Tennisklubb har tre grusbaner ved Ås stadion. Les om booking, regler og banereglement."
  pageTitle="Baner"
  pageDescription="Tre grusbaner ved Ås stadion – tilgjengelige for medlemmer fra april til november."
>
  <Container padded>
    <!-- Intro -->
    <PageSection title="Spill tennis i Ås">
      <RichTextBlock class="mb-6">
        <p>
          Ås Tennisklubb disponerer tre grusbaner i Idrettsveien, rett ved Ås stadion. Fra april til
          november kan du som medlem spille så ofte du vil.
        </p>
      </RichTextBlock>

      <!-- Medlemskap og praktisk info -->
      <Callout class="mb-8">
        <p class="mb-3 font-semibold text-brand-800 dark:text-brand-300">
          Du må være medlem for å spille på banene.
        </p>
        <BulletList
          items={[
            "Booking er gratis og kan gjøres opptil 7 dager i forveien.",
            "Tilgang til bane og klubbhus får du via Yale Home-appen.",
            '<a href="#banereglement" class="text-brand-700 dark:text-brand-400 underline">Les banereglementet</a> før du spiller.',
          ]}
        />
      </Callout>

      <div class="mb-8 flex flex-wrap gap-4">
        <Button href={`${base}medlemskap`}>Bli medlem →</Button>
        <Button variant="outline" href={import.meta.env.PUBLIC_BOOKING_URL} target="_blank" rel="noopener noreferrer">
          <CalendarCheck class="h-5 w-5" />
          Book bane
        </Button>
      </div>
    </PageSection>

    <!-- Kart -->
    <PageSection title="Her finner du oss">
      <LazyMap
        address="Idrettsveien 1"
        city="1430 Ås"
        embedQuery="Idrettsveien 1, 1430 Ås, Norway"
        mapsUrl="https://maps.google.com/maps?q=Idrettsveien+1,+1430+Ås,+Norway"
      />
    </PageSection>

    <!-- Banereglement -->
    <PageSection title="Banereglement" id="banereglement">
      <RichTextBlock class="mb-6">
        <p>For å holde banene i god stand for alle, ber vi om at følgende regler følges:</p>
      </RichTextBlock>
      <RuleList rules={reglement} />
    </PageSection>
  </Container>
</Layout>
