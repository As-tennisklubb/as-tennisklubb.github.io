---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck, Info } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import RuleList from "../components/content/RuleList.astro";
import LazyMap from "../components/content/LazyMap.astro";
import BulletList from "../components/ui/BulletList.astro";

const base = import.meta.env.BASE_URL;

const reglement = [
  "Det er kun betalende medlemmer som kan spille på banene.",
  "Prøvespill/gjestespill for ikke-medlemmer – se <a href='#prøvespill' class='text-brand-700 dark:text-brand-400 underline'>regler for prøvespill</a> lenger ned på denne siden.",
  "Baner skal vannes før bruk når grusen er tørr. Spill på tørr bane er forbudt! Se demovideo for bruk av vanningsanlegget.",
  "Av hensyn til naboer skal banen ikke benyttes før kl. 07.00 eller etter kl. 22.30.",
  "Hver spiller er begrenset til én bestilling per dag. Husk å kansellere bestillingen i god tid!",
  "Styret har rett til å reservere alle baner ved trening, kurs, drop-in, arrangementer o.l.",
  "Banene skal alltid kostes etter bruk – start ytterst langs gjerde og gå i sirkler mot midten.",
  "Bruk tennissko/joggesko med jevn såle! Fottøy med grov struktur ødelegger banen og er ikke tillatt.",
  "En bane regnes som spillbar dersom det ikke forekommer vanndammer.",
  "Alle medlemmer plikter å bidra med stell av linjer. Dersom en linje løsner skal den umiddelbart vannes og bankes ned i grusen med egen stamper.",
  "Etterlat ikke drikkeflasker, tomme ballrør eller søppel på banen. Bruk søppelkassene.",
  "De som sist forlater baneanlegget om kvelden plikter å slå av banelyset og påse at døren til klubbhuset og porten til banen er låst.",
  "Kontakt anleggsansvarlig om noe er galt med banene.",
];
---

<Layout
  title="Baner – Ås Tennisklubb"
  description="Ås Tennisklubb har tre grusbaner ved Ås stadion. Les om booking, regler og banereglement."
  pageTitle="Baner"
  pageDescription="Tre grusbaner ved Ås stadion – tilgjengelige for medlemmer fra april til november."
>
  <Container padded>
    <!-- Utendørs -->
    <PageSection title="Utendørs">
      <RichTextBlock class="mb-6">
        <p>
          Ås Tennisklubb disponerer tre grusbaner i Idrettsveien, rett ved Ås stadion. Fra april til
          november kan du som medlem spille så ofte du vil.
        </p>
      </RichTextBlock>

      <Button
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mb-8"
      >
        <CalendarCheck class="h-5 w-5" />
        Book bane
      </Button>

      <!-- Viktig å vite -->
      <Callout class="mb-4">
        <div class="mb-4 flex items-center gap-2">
          <Info class="h-5 w-5 shrink-0 text-brand-700 dark:text-brand-400" />
          <h3 class="font-semibold text-brand-800 dark:text-brand-300">Viktig å vite</h3>
        </div>
        <BulletList
          items={[
            "Det koster ingenting å bestille, men alle som benytter banen må være registrerte medlemmer i Ås Tennisklubb.",
            'Alle spillere plikter å følge <a href="#banereglement" class="text-brand-700 dark:text-brand-400 underline">klubbens banereglement</a>.',
            "Hver spiller er begrenset til én bestilling per dag.",
            "Bestilling kan gjøres maksimum 7 dager i forveien.",
            "Faste timer og arrangementer er satt av i kalenderen og kan ikke reserveres.",
          ]}
        />
      </Callout>

      <!-- Adgang -->
      <Card>
        <h3 class="mb-2 font-semibold text-gray-900 dark:text-gray-100">
          Adgang til bane og klubbhus
        </h3>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Alle betalende medlemmer får tilgang via <strong class="text-gray-800 dark:text-gray-200"
            >Yale Home-appen</strong
          >.
          <a href={`${base}medlemskap`} class="link ml-1">Se medlemskapssiden for detaljer →</a>
        </p>
      </Card>
    </PageSection>

    <!-- Kart -->
    <PageSection title="Her finner du oss">
      <LazyMap
        address="Idrettsveien 1"
        city="1430 Ås"
        embedQuery="Idrettsveien 1, 1430 Ås, Norway"
        mapsUrl="https://maps.google.com/maps?q=Idrettsveien+1,+1430+Ås,+Norway"
      />
    </PageSection>

    <!-- Banereglement -->
    <PageSection title="Banereglement" id="banereglement">
      <RuleList rules={reglement} />
    </PageSection>

    <!-- Prøvespill -->
    <PageSection title="Prøvespill" id="prøvespill">
      <RichTextBlock class="mb-4">
        <p>
          Ikke medlem ennå? Du er hjertelig velkommen til å prøvespille. For at ordningen ikke skal
          misbrukes gjelder følgende regler:
        </p>
      </RichTextBlock>
      <BulletList
        items={[
          "Prøvespill gjelder kun én gang per person.",
          "Baneleie for prøvespill er kr 200,- for 1 time. Beløpet refunderes ved tegning av medlemskap.",
          "Betal til konto 1100 44 76109 eller Vipps Ås Tennisklubb #14506.",
          "Send mail til im@aastk.no med mobilnummer – du får tilgang via Yale Home-appen.",
        ]}
        class="mb-6"
      />
      <Button variant="outline" href="mailto:im@aastk.no" class="text-sm">
        Send mail for prøvespill →
      </Button>
    </PageSection>
  </Container>
</Layout>
