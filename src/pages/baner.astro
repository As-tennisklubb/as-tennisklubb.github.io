---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck, MapPin } from "@lucide/astro";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import Link from "../components/ui/Link.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";
import DataTable from "../components/ui/DataTable.astro";
import RuleList from "../components/content/RuleList.astro";
import LazyMap from "../components/content/LazyMap.astro";

const base = import.meta.env.BASE_URL;

const reglement = [
  "Banene må vannes før bruk når grusen er tørr.",
  "Banene kan benyttes mellom kl. 07.00 og 22.30.",
  "Hver spiller kan bestille én bane per dag.",
  "Kanseller bestillingen i god tid hvis du ikke kan spille.",
  "Kost banen etter bruk – start ytterst langs gjerdet og jobb deg innover.",
  "Bruk sko med jevn såle – grov såle ødelegger grusen.",
  "Banen er spillbar så lenge det ikke står vann på den.",
  "Dersom en linje løsner, vann den og bank den ned med stamperen.",
  "Kast søppel, flasker og tomme ballrør i søppelkassene.",
  "Den som forlater anlegget sist, slår av lyset og låser port og klubbhus.",
  "Kontakt klubben dersom du oppdager feil på banene.",
];
---

<Layout
  title="Baner – Ås Tennisklubb"
  description="Ås Tennisklubb har tre grusbaner ved Ås stadion. Les om booking, regler og banereglement."
>
  {/* ───── Toppseksjon ───── */}
  <PageHeader
    title="Baner"
    description="Tre grusbaner ved Ås stadion – tilgjengelige for medlemmer fra april til november."
  />

  {/* ───── Sideinnhold ───── */}
  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">

    {/* Spill tennis i Ås */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Spill tennis i Ås</Heading>
          <BodyLong>
            Ås Tennisklubb har tre grusbaner i Idrettsveien, rett ved Ås stadion.
            Som medlem kan du spille så ofte du vil fra april til november.
          </BodyLong>
          <DataTable
            rows={[
              { label: "Bane A", value: "Grus – kveldslys" },
              { label: "Bane B", value: "Grus – kveldslys" },
              { label: "Bane C", value: "Grus – uten lys" },
            ]}
            labelHeader="Bane"
            valueHeader="Underlag og lys"
          />
          <HStack gap="4" wrap>
            <Button href={`${base}medlemskap`}>Bli medlem →</Button>
            <Button
              variant="secondary"
              href={import.meta.env.PUBLIC_BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <CalendarCheck class="h-5 w-5" slot="icon" />
              Book bane
            </Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>

    {/* Praktisk informasjon */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Praktisk informasjon</Heading>
          <BodyLong>
            For å bruke banene må du være medlem. Booking er gratis og kan gjøres opptil
            7 dager i forveien. Tilgang til bane og klubbhus skjer via Yale Home-appen, og
            racketer og baller kan lånes gratis i klubbhuset. Banene kan brukes mellom
            kl. 07.00 og 22.30 – bane A og B har kveldslys.
            <Link href="#banereglement" inlineText>Se banereglementet</Link> før du spiller.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Banereglement */}
    <section id="banereglement">
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Banereglement</Heading>
          <BodyLong>For å holde banene i god stand for alle, ber vi om at følgende regler følges:</BodyLong>
          <RuleList rules={reglement} />
        </VStack>
      </PageBlock>
    </section>

    {/* Kart */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <HStack gap="3" align="center">
            <MapPin class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Her finner du oss</Heading>
          </HStack>
          <LazyMap
            address="Idrettsveien 1"
            city="1430 Ås"
            embedQuery="Idrettsveien 1, 1430 Ås, Norway"
            mapsUrl="https://maps.google.com/maps?q=Idrettsveien+1,+1430+Ås,+Norway"
          />
        </VStack>
      </PageBlock>
    </section>

    {/* Utenom sesongen */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="2">
          <Heading level={2} size="medium" dataColor="brand">Utenom sesongen</Heading>
          <BodyLong>
            Banene er normalt stengt fra november til april. Klubben har også aktivitet
            gjennom vinteren – følg med på <Link href={`${base}arrangementer`} inlineText>arrangementssiden</Link> for oppdateringer.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

  </VStack>
</Layout>
