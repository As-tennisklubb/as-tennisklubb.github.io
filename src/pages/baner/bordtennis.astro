---
import Layout from "../../layouts/Layout.astro";
import { CalendarCheck, MapPin } from "@lucide/astro";
import Button from "../../components/ui/Button.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import Heading from "../../components/ui/Heading.astro";
import BodyLong from "../../components/ui/BodyLong.astro";
import Link from "../../components/ui/Link.astro";
import PageBlock from "../../components/primitives/PageBlock.astro";
import VStack from "../../components/primitives/VStack.astro";
import HStack from "../../components/primitives/HStack.astro";
import LazyMap from "../../components/content/LazyMap.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Bordtennis – Holstad skole – Ås Tennisklubb"
  description="Innendørs bordtennis hele året på Holstad skole i Ås. Tilgang for medlemmer."
>
  <PageHeader
    variant="compact"
    title="Bordtennis – Holstad skole"
    description="Innendørs bordtennis hele året – for alle medlemmer."
  />

  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* Om tilbudet */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Spill hele året</Heading>
          <BodyLong>
            Klubben har bordtennis innendørs på Holstad skole, ved Steinerskolen i Ås. Tilbudet er
            åpent hele året og krever medlemskap. For tilgang til lokalet, kontakt Rolf Otto
            Østenstad på telefon
            <Link href="tel:+4741414955" inlineText>414 14 955</Link>.
          </BodyLong>
          <HStack gap="4" wrap>
            <Button href={`${base}medlemskap`}>Bli medlem →</Button>
            <Button
              variant="secondary"
              href={import.meta.env.PUBLIC_BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <CalendarCheck class="h-5 w-5" slot="icon" />
              Book bane
            </Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>

    {/* Kart */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <HStack gap="3" align="center">
            <MapPin class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Finn oss</Heading>
          </HStack>
          <LazyMap
            address="Holstadveien 25"
            city="1440 Drøbak"
            embedQuery="Holstad skole, Ås, Norway"
            mapsUrl="https://maps.google.com/maps?q=Holstad+skole,+Ås,+Norway"
          />
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
