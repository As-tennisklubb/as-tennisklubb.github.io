---
import Layout from "../../layouts/Layout.astro";
import { CalendarCheck, MapPin } from "@lucide/astro";
import Button from "../../components/ui/Button.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import Heading from "../../components/ui/Heading.astro";
import BodyLong from "../../components/ui/BodyLong.astro";
import Link from "../../components/ui/Link.astro";
import PageBlock from "../../components/primitives/PageBlock.astro";
import VStack from "../../components/primitives/VStack.astro";
import HStack from "../../components/primitives/HStack.astro";
import LazyMap from "../../components/content/LazyMap.astro";
import List from "../../components/ui/List.astro";
import ListItem from "../../components/ui/ListItem.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Bordtennis – Gamle Holstad skole – Ås Tennisklubb"
  description="Innendørs bordtennis hele året på Gamle Holstad skole i Ås. Tilgang for medlemmer."
  heroLayout
>
  <PageHeader
    variant="compact"
    title="Bordtennis – Gamle Holstad skole"
    description="Innendørs bordtennis hele året – for alle medlemmer."
    heroCategory="bordtennis"
  />

  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* Om tilbudet */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Spill hele året</Heading>
          <BodyLong>
            Klubben har bordtennis innendørs på Gamle Holstad skole, ved Steinerskolen i Ås.
            Tilbudet er åpent hele året og krever medlemskap. For tilgang til lokalet, kontakt Rolf
            Otto Østenstad på telefon
            <Link href="tel:+4741414955" inlineText>414 14 955</Link>
          </BodyLong>
          <HStack gap="4" wrap>
            <Button href={`${base}medlemskap`}>Bli medlem →</Button>
            <Button
              variant="secondary"
              href={import.meta.env.PUBLIC_BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <CalendarCheck class="h-5 w-5" slot="icon" />
              Book bane
            </Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>

    {/* Bookingreglement */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Bookingreglement</Heading>
          <List size="small">
            <ListItem>Kun medlemmer kan booke og spille på bordtennisbordet</ListItem>
            <ListItem>Booking er mulig mellom 06:00 og 23:00</ListItem>
            <ListItem>Antall aktive bookinger er ikke begrenset per nå</ListItem>
          </List>
        </VStack>
      </PageBlock>
    </section>

    {/* Rydd etter deg */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Rydd etter deg</Heading>
          <BodyLong>
            Legg tilbake bøller og utstyr på plass etter bruk, og rydd bordet så det er klart for
            neste. Den som forlater lokalet sist slår av lyset og låser døren.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Kart */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <HStack gap="3" align="center">
            <MapPin class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Finn oss</Heading>
          </HStack>
          <LazyMap
            address="Haugerudveien 23"
            city="1434 Ås"
            embedQuery="Haugerudveien 23, 1434 Ås, Norway"
            mapsUrl="https://maps.google.com/maps?q=Haugerudveien+23,+1434+Ås,+Norway"
          />
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
