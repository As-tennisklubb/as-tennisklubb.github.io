---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/layout/Container.astro";
import RichTextBlock from "../../components/ui/RichTextBlock.astro";
import Blockquote from "../../components/ui/Blockquote.astro";
import ArticleMeta from "../../components/content/ArticleMeta.astro";
import AttachmentList from "../../components/content/AttachmentList.astro";
import BackLink from "../../components/content/BackLink.astro";
import ArticleHeading from "../../components/content/ArticleHeading.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
const ingress = post.data.ingress ?? post.data.description;
const formattedDate = post.data.date.toLocaleDateString("no-NO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={`${post.data.title} – Ås Tennisklubb`} description={ingress}>
  <Container size="narrow" padded class="pt-10">
    <BackLink href={`${base}nyheter`}>← Alle nyheter</BackLink>
    <article>
      <ArticleHeading>{post.data.title}</ArticleHeading>

      <!-- Metadata -->
      <ArticleMeta
        date={formattedDate}
        author={post.data.author}
        categories={categories}
        class="mb-6 border-b border-gray-100 pb-6 dark:border-gray-700"
      />

      <!-- Cover-bilde -->
      {
        post.data.cover && (
          <div class="mb-6 overflow-hidden rounded-xl">
            <img
              src={post.data.cover}
              alt={post.data.title}
              class="max-h-96 w-full object-cover"
              loading="lazy"
            />
          </div>
        )
      }

      <!-- Ingress -->
      {ingress && <Blockquote class="mb-8">{ingress}</Blockquote>}

      <!-- Innhold -->
      <RichTextBlock>
        <Content />
      </RichTextBlock>

      <!-- Vedlegg -->
      {
        post.data.attachments && post.data.attachments.length > 0 && (
          <div class="mt-8 border-t border-gray-100 pt-6 dark:border-gray-700">
            <h2 class="mb-4 text-lg font-bold text-gray-800 dark:text-gray-200">Vedlegg</h2>
            <AttachmentList attachments={post.data.attachments.map((url) => ({ url }))} />
          </div>
        )
      }
    </article>

    <nav class="mt-10 flex flex-wrap items-center gap-4 border-t border-gray-100 pt-6 dark:border-gray-700">
      <a
        href={`${base}nyheter`}
        class="link inline-flex min-h-[44px] items-center text-sm"
      >
        ← Alle nyheter
      </a>
      <a
        href={base}
        class="link inline-flex min-h-[44px] items-center text-sm"
      >
        Til forsiden
      </a>
    </nav>
  </Container>
</Layout>
