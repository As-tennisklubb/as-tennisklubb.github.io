---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import Heading from "../../components/ui/Heading.astro";
import BodyLong from "../../components/ui/BodyLong.astro";
import Link from "../../components/ui/Link.astro";
import PageBlock from "../../components/primitives/PageBlock.astro";
import VStack from "../../components/primitives/VStack.astro";
import HStack from "../../components/primitives/HStack.astro";
import Prose from "../../components/ui/Prose.astro";
import ArticleMeta from "../../components/content/ArticleMeta.astro";
import AttachmentList from "../../components/content/AttachmentList.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
const ingress = post.data.ingress ?? post.data.description;
const formattedDate = post.data.date.toLocaleDateString("no-NO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={`${post.data.title} – Ås Tennisklubb`} description={ingress}>
  <PageHeader title={post.data.title} description={ingress} heroCategory="tennis" />
  <PageBlock width="md" gutters>
    <VStack gap="6" class="py-10">
      {/* ───── Tilbake-lenke ───── */}
      <Link href={`${base}nyheter`} class="text-sm"> ← Alle nyheter </Link>

      {/* ───── Metadata ───── */}
      <ArticleMeta
        date={formattedDate}
        author={post.data.author}
        categories={categories}
        class="border-b [border-color:var(--aastk-border-subtle)] pb-6"
      />

      {/* ───── Cover-bilde ───── */}
      {
        post.data.cover && (
          <div class="overflow-hidden rounded-xl">
            <img
              src={post.data.cover}
              alt={post.data.title}
              class="max-h-96 w-full object-cover"
              loading="lazy"
            />
          </div>
        )
      }

      {/* ───── Ingress ───── */}
      {ingress && <BodyLong class="text-body text-lg">{ingress}</BodyLong>}

      {/* ───── Innhold ───── */}
      <Prose>
        <Content />
      </Prose>

      {/* ───── Vedlegg ───── */}
      {
        post.data.attachments && post.data.attachments.length > 0 && (
          <div class="border-t [border-color:var(--aastk-border-subtle)] pt-6">
            <Heading level={2} size="small" class="mb-4">
              Vedlegg
            </Heading>
            <AttachmentList attachments={post.data.attachments.map((url) => ({ url }))} />
          </div>
        )
      }

      {/* ───── Navigasjon ───── */}
      <nav
        class="flex flex-wrap items-center gap-4 border-t [border-color:var(--aastk-border-subtle)] pt-6"
      >
        <Link href={`${base}nyheter`} class="text-sm"> ← Alle nyheter </Link>
        <Link href={base} class="text-sm"> Til forsiden </Link>
      </nav>
    </VStack>
  </PageBlock>
</Layout>
