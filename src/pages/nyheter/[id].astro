---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Heading from "../../components/ui/Heading.astro";
import BodyLong from "../../components/ui/BodyLong.astro";
import Link from "../../components/ui/Link.astro";
import SportBadge from "../../components/ui/SportBadge.astro";
import Prose from "../../components/ui/Prose.astro";
import AttachmentList from "../../components/content/AttachmentList.astro";
import DetailPageLayout from "../../components/layout/DetailPageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const ingress = post.data.ingress ?? post.data.description;

const sportSlugs = ["tennis", "bordtennis", "padel"] as const;
type Sport = (typeof sportSlugs)[number];
const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
const sport = categories.find((c): c is Sport =>
  (sportSlugs as readonly string[]).includes(c.toLowerCase()),
);
const otherCategories = categories.filter(
  (c) => !(sportSlugs as readonly string[]).includes(c.toLowerCase()),
);
const formattedDate = post.data.date.toLocaleDateString("nb-NO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={`${post.data.title} – Ås Tennisklubb`} description={ingress}>
  <DetailPageLayout>
    {/* ───── Badges + tittel ───── */}
    <div>
      <div class="mb-3 flex flex-wrap items-center gap-2">
        {sport && <SportBadge sport={sport} />}
        {
          otherCategories.map((c) => (
            <span class="rounded-full bg-[var(--aastk-surface-subtle)] px-3 py-1 text-xs font-medium text-[var(--aastk-text-muted)]">
              {c}
            </span>
          ))
        }
      </div>
      <Heading level={1} size="large">{post.data.title}</Heading>
      <p class="text-muted mt-2 text-sm">{formattedDate}</p>
    </div>

    {/* ───── Cover-bilde ───── */}
    {
      post.data.cover && (
        <div class="overflow-hidden rounded-xl">
          <img
            src={post.data.cover}
            alt={post.data.title}
            class="max-h-96 w-full object-cover"
            loading="lazy"
          />
        </div>
      )
    }

    {/* ───── Ingress ───── */}
    {ingress && <BodyLong class="text-body text-lg">{ingress}</BodyLong>}

    {/* ───── Innhold ───── */}
    <Prose>
      <Content />
    </Prose>

    {/* ───── Vedlegg ───── */}
    {
      post.data.attachments && post.data.attachments.length > 0 && (
        <div class="border-t [border-color:var(--aastk-border-subtle)] pt-6">
          <Heading level={2} size="small" class="mb-4">
            Vedlegg
          </Heading>
          <AttachmentList attachments={post.data.attachments.map((url) => ({ url }))} />
        </div>
      )
    }
  </DetailPageLayout>
</Layout>
