---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("news");
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const base = import.meta.env.BASE_URL;
---

<Layout title="Nyheter – Ås Tennisklubb" description="Siste nyheter fra Ås Tennisklubb." pageTitle="Nyheter" pageDescription={`${sortedPosts.length} innlegg fra Ås Tennisklubb`}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-4">
      {sortedPosts.map((post) => {
        const categories = post.data.categories?.filter(c => c !== "ukategorisert") ?? [];
        return (
          <a href={`${base}nyheter/${post.id}`} class="group block bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-xs font-medium text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 py-0.5 rounded-full">
                {post.data.date.toLocaleDateString("no-NO", { day: "numeric", month: "long", year: "numeric" })}
              </span>
              {categories.map(cat => (
                <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">{cat}</span>
              ))}
            </div>
            <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">{post.data.description}</p>
            )}
          </a>
        );
      })}
    </div>
  </div>
</Layout>
