---
import { getCollection } from "astro:content";
import { Rss } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import NewsCard from "../../components/content/NewsCard.astro";
import Link from "../../components/ui/Link.astro";
import PageBlock from "../../components/primitives/PageBlock.astro";
import VStack from "../../components/primitives/VStack.astro";
import HStack from "../../components/primitives/HStack.astro";
import HGrid from "../../components/primitives/HGrid.astro";

const posts = await getCollection("news");
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Nyheter - Ås Tennisklubb"
  description="Siste nytt fra Ås Tennisklubb."
>
  <PageHeader
    variant="compact"
    title="Nyheter"
    description={`${sortedPosts.length} innlegg fra Ås Tennisklubb`}
  />

  <section>
    <PageBlock width="xl" gutters>
      <VStack gap="6">
        <HStack justify="end">
          <Link href={`${base}rss.xml`} dataColor="subtle">
            <HStack gap="2" align="center" as="span">
              <Rss size={16} />
              RSS
            </HStack>
          </Link>
        </HStack>

        <HGrid columns={{ sm: 1, md: 3 }} gap="6">
          {
            sortedPosts.map((post) => {
              const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
              return (
                <NewsCard
                  href={`${base}nyheter/${post.id}`}
                  title={post.data.title}
                  date={post.data.date.toLocaleDateString("no-NO", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                  categories={categories}
                  excerpt={post.data.ingress ?? post.data.description}
                  headingLevel={2}
                  clampLines={3}
                />
              );
            })
          }
        </HGrid>
      </VStack>
    </PageBlock>
  </section>
</Layout>
