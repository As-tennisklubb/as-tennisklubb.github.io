---
import Layout from "../layouts/Layout.astro";
import { Mail, Users } from "@lucide/astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import Link from "../components/ui/Link.astro";
import DataTable from "../components/ui/DataTable.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";

const styret = [
  { navn: "Øyvind Engøy", rolle: "Leder", epost: "leder@aastk.no", tlf: "950 55 078" },
  { navn: "Lars Rønn", rolle: "Nestleder", epost: "nestleder@aastk.no", tlf: "951 26 858" },
  {
    navn: "Lone Ross",
    rolle: "Administrasjon",
    epost: "administrasjon@aastk.no",
    tlf: "911 97 268",
  },
  { navn: "James Randall Fennell", rolle: "Anlegg", epost: "anlegg@aastk.no", tlf: "997 98 972" },
  { navn: "Rune Sundbø", rolle: "Dugnad / anlegg", epost: "anlegg@aastk.no", tlf: "922 83 185" },
];

const styretData = styret.map(({ navn, rolle, epost, tlf }) => [
  navn,
  rolle,
  { text: epost, href: `mailto:${epost}` },
  { text: tlf, href: `tel:+47${tlf.replace(/\s/g, "")}` },
]);
---

<Layout
  title="Kontakt – Ås Tennisklubb"
  description="Kontaktinformasjon for Ås Tennisklubb. Styret, e-post og telefon."
>
  {/* ───── Toppseksjon ───── */}
  <PageHeader title="Kontakt" description="Ta kontakt med oss – vi hjelper deg gjerne." heroCategory="tennis" />

  {/* ───── Sideinnhold ───── */}
  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* Generelle henvendelser */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4" class="max-w-prose">
          <HStack gap="3" align="center">
            <Mail class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Generelle henvendelser</Heading>
          </HStack>
          <BodyLong>
            Har du spørsmål om medlemskap, baner, booking eller arrangementer? Send oss en e-post –
            vi svarer så raskt vi kan.
          </BodyLong>
          <Link href="mailto:administrasjon@aastk.no" class="text-lg font-semibold">
            administrasjon@aastk.no
          </Link>
        </VStack>
      </PageBlock>
    </section>

    {/* Styret */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <HStack gap="3" align="center">
            <Users class="size-6 text-[var(--aastk-text-brand)]" />
            <Heading level={2} size="medium" dataColor="brand">Styret</Heading>
          </HStack>
          <BodyLong>
            Har du en spesifikk henvendelse? Ta direkte kontakt med riktig person i styret.
          </BodyLong>
          <DataTable headers={["Navn", "Rolle", "E-post", "Telefon"]} data={styretData} />
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
