---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import HeroSection from "../components/layout/HeroSection.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Button from "../components/ui/Button.astro";
import LinkCard from "../components/content/LinkCard.astro";
import NewsCard from "../components/content/NewsCard.astro";
import EventCard from "../components/events/EventCard.astro";
import { fetchUpcomingEvents } from "../lib/events/fetchEvents";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcomingEvents = (await fetchUpcomingEvents()).slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennisklubb – Hjem"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "no" },
    { href: new URL("english", Astro.site).href, hrefLang: "en" },
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "x-default" },
  ]}
>
  <!-- Hero -->
  <HeroSection
    title="Spill tennis i Ås"
    description="Tre grusbaner ved Ås stadion – åpne fra april til november."
  >
    <div class="mt-6 flex flex-wrap gap-4">
      <Button variant="ghost" href={`${base}medlemskap`}>Bli medlem</Button>
      <Button
        variant="secondary"
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer">Book bane</Button
      >
    </div>
  </HeroSection>

  <!-- Tre veier inn -->
  <Container size="wide" class="py-12">
    <CardGrid cols={3}>
      <LinkCard
        href={import.meta.env.PUBLIC_BOOKING_URL}
        title="Spill tennis"
        description="Bli medlem og reserver bane – enkelt og raskt."
        linkText="Gå til booking →"
      />
      <LinkCard
        href={`${base}medlemskap`}
        title="Bli medlem"
        description="Spill så mye du vil hele sesongen. Fra kr 500,-."
        linkText="Se priser og meld deg inn →"
      />
      <LinkCard
        href={`${base}arrangementer`}
        title="Arrangementer og kurs"
        description="Kurs, turneringer og aktiviteter gjennom sesongen."
        linkText="Se hva som skjer →"
      />
    </CardGrid>
  </Container>

  <!-- Kommende arrangementer -->
  {
    upcomingEvents.length > 0 && (
      <Container size="wide" class="py-12">
        <PageSection title="Kommende arrangementer">
          <CardGrid cols={3}>
            {upcomingEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </CardGrid>
          <div class="mt-6 text-center">
            <Button href={`${base}arrangementer`}>Se alle arrangementer →</Button>
          </div>
        </PageSection>
      </Container>
    )
  }

  <!-- Nytt fra klubben -->
  {
    latestNews.length > 0 && (
      <section class="bg-gray-50 py-12 dark:bg-gray-900">
        <Container size="wide">
          <PageSection title="Nytt fra klubben">
            <CardGrid cols={3}>
              {latestNews.map((post) => {
                const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
                return (
                  <NewsCard
                    href={`${base}nyheter/${post.id}`}
                    title={post.data.title}
                    date={post.data.date.toLocaleDateString("no-NO", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                    categories={categories}
                    excerpt={post.data.ingress ?? post.data.description}
                  />
                );
              })}
            </CardGrid>
            <div class="mt-6 text-center">
              <Button href={`${base}nyheter`}>Se alle nyheter →</Button>
            </div>
          </PageSection>
        </Container>
      </section>
    )
  }

</Layout>
