---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { MapPin, Trophy, Laugh } from "@lucide/astro";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout title="Ås Tennisklubb – Hjem">

  <!-- Hero -->
  <section class="bg-green-800 dark:bg-green-700 text-white py-10 md:py-14 px-4">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-3">
        Tennis for alle
      </h1>
      <p class="text-green-200 text-base md:text-lg max-w-md">
        Vi har skapt tennisglede for barn, unge og voksne i nærmiljøet i snart 50 år.      </p>
      <div class="flex flex-wrap gap-4 mt-6">
        <a href="https://banebooking.aastk.no" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-green-700 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-full min-h-[44px] transition-colors border border-green-500">Book bane</a>
        <a href={`${base}medlemskap`} class="inline-flex items-center gap-2 border-2 border-white text-white hover:bg-green-700 font-semibold px-6 py-3 rounded-full min-h-[44px] transition-colors">Bli med i dag</a>
      </div>
    </div>
  </section>

  <!-- Info-kort (§6 Gestalt: proximity, similarity) -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid gap-6 md:grid-cols-3">
      <a href={`${base}trening`} class="group flex flex-col bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
        <div class="mb-3"><Laugh class="w-8 h-8 text-green-700 dark:text-green-400" /></div>
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors mb-2">Tennismoro</h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm">Vi tilbyr trening for barn, ungdom og voksne – fra nybegynner til turnering.</p>
        <span class="inline-flex items-center gap-1 mt-auto pt-4 text-green-700 dark:text-green-400 font-semibold text-sm">Se treningsplan →</span>
      </a>
      <a href={`${base}baner`} class="group flex flex-col bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
        <div class="mb-3"><MapPin class="w-8 h-8 text-green-700 dark:text-green-400" /></div>
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors mb-2">Våre baner</h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm">Vi har tre grusbaner ved Ås stadion, tilgjengelige for leie fra april til november.</p>
        <span class="inline-flex items-center gap-1 mt-auto pt-4 text-green-700 dark:text-green-400 font-semibold text-sm">Se baneoversikt →</span>
      </a>
      <a href={`${base}medlemskap`} class="group flex flex-col bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
        <div class="mb-3"><Trophy class="w-8 h-8 text-green-700 dark:text-green-400" /></div>
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors mb-2">Bli med i klubben</h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm">Spill så mye du vil – alle medlemmer har fri tilgang til banene hele sesongen.</p>
        <span class="inline-flex items-center gap-1 mt-auto pt-4 text-green-700 dark:text-green-400 font-semibold text-sm">Se medlemskap →</span>
      </a>
    </div>
  </section>

  <!-- Siste nyheter -->
  {latestNews.length > 0 && (
    <section class="bg-gray-50 dark:bg-gray-900 py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-green-800 dark:text-green-300 mb-8">Siste nyheter</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {latestNews.map((post) => {
            const categories = post.data.categories?.filter(c => c !== "ukategorisert") ?? [];
            return (
              <a href={`${base}nyheter/${post.id}`} class="group block bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-xs font-medium text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 py-0.5 rounded-full">
                    {post.data.date.toLocaleDateString("no-NO", { day: "numeric", month: "long", year: "numeric" })}
                  </span>
                  {categories.map(cat => (
                    <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">{cat}</span>
                  ))}
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors mb-0">
                  {post.data.title}
                </h3>
                {(post.data.ingress ?? post.data.description) && (
                  <p class="text-gray-600 dark:text-gray-400 text-sm mt-2 line-clamp-2">{post.data.ingress ?? post.data.description}</p>
                )}
              </a>
            );
          })}
        </div>
        <div class="mt-8 text-center">
          <a href={`${base}nyheter`} class="inline-flex items-center gap-2 bg-green-700 text-white px-6 py-3 rounded-full hover:bg-green-800 transition-colors font-semibold min-h-[44px]">
            Se alle nyheter →
          </a>
        </div>
      </div>
    </section>
  )}

</Layout>
