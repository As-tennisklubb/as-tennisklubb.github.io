---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import HeroSection from "../components/layout/HeroSection.astro";
import Container from "../components/layout/Container.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Button from "../components/ui/Button.astro";
import LinkCard from "../components/content/LinkCard.astro";
import NewsCard from "../components/content/NewsCard.astro";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennisklubb – Hjem"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "no" },
    { href: new URL("english", Astro.site).href, hrefLang: "en" },
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "x-default" },
  ]}
>
  <!-- Hero -->
  <HeroSection>
    <h1 class="mb-3 text-3xl font-bold md:text-5xl">Tennis for alle</h1>
    <p class="max-w-md text-base text-brand-200 md:text-lg">
      Vi har skapt tennisglede for barn, unge og voksne i nærmiljøet i 50 år.
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <Button
        variant="ghost"
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer">Book bane</Button
      >
      <Button variant="secondary" href={`${base}arrangementer`}>Se arrangementer</Button>
    </div>
  </HeroSection>

  <!-- Info-kort -->
  <Container size="wide" class="py-12">
    <CardGrid cols={3}>
      <LinkCard
        href={`${base}arrangementer`}
        title="Arrangementer"
        description="Dugnader, turneringer og stigespill – se hva som skjer i klubben."
        linkText="Se arrangementer →"
      />
      <LinkCard
        href={`${base}baner`}
        title="Våre baner"
        description="Vi har tre grusbaner ved Ås stadion, tilgjengelige for leie fra april til november."
        linkText="Se baneoversikt →"
      />
      <LinkCard
        href={`${base}medlemskap`}
        title="Bli med i klubben"
        description="Spill så mye du vil – alle medlemmer har fri tilgang til banene hele sesongen."
        linkText="Se medlemskap →"
      />
    </CardGrid>
  </Container>

  <!-- Siste nyheter -->
  {
    latestNews.length > 0 && (
      <section class="bg-gray-50 py-12 dark:bg-gray-900">
        <Container size="wide">
          <h2 class="mb-6 text-3xl font-bold text-brand-800 dark:text-brand-300">Siste nyheter</h2>
          <CardGrid cols={3}>
            {latestNews.map((post) => {
              const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
              return (
                <NewsCard
                  href={`${base}nyheter/${post.id}`}
                  title={post.data.title}
                  date={post.data.date.toLocaleDateString("no-NO", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                  categories={categories}
                  excerpt={post.data.ingress ?? post.data.description}
                />
              );
            })}
          </CardGrid>
          <div class="mt-6 text-center">
            <Button href={`${base}nyheter`}>Se alle nyheter →</Button>
          </div>
        </Container>
      </section>
    )
  }
</Layout>
