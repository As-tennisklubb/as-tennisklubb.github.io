---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Dumbbell, MapPin, Trophy, Volleyball, Laugh } from "@lucide/astro";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout title="Ås Tennisklubb – Hjem">

  <!-- Hero -->
  <section class="bg-green-800 dark:bg-green-700 text-white py-10 md:py-14 px-4">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-3">
        Tennis for alle
      </h1>
      <p class="text-green-200 text-base md:text-lg max-w-md">
        Uansett alder og nivå – bli med oss på banen i Ås!
      </p>
    </div>
  </section>

  <!-- Info-kort (§6 Gestalt: proximity, similarity) -->
  <section class="max-w-6xl mx-auto px-4 py-16 grid md:grid-cols-3 gap-8">
    <div class="text-center p-6 rounded-xl bg-green-50 dark:bg-gray-800">
      <div class="flex justify-center mb-3"><Laugh class="w-10 h-10 text-green-700 dark:text-green-400" /></div>
      <h2 class="text-xl font-bold mb-2 text-green-800 dark:text-green-300">Tennismoro</h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm">Vi tilbyr trening for barn, ungdom og voksne – fra nybegynner til turnering.</p>
      <a href={`${base}trening`} class="inline-block mt-4 text-green-700 dark:text-green-400 font-semibold hover:underline">Se treningsplan →</a>
    </div>
    <div class="text-center p-6 rounded-xl bg-green-50 dark:bg-gray-800">
      <div class="flex justify-center mb-3"><MapPin class="w-10 h-10 text-green-700 dark:text-green-400" /></div>
      <h2 class="text-xl font-bold mb-2 text-green-800 dark:text-green-300">Våre baner</h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm">Vi har tre grusbaner ved Ås stadion, tilgjengelige for leie fra april til november.</p>
      <a href={`${base}baner`} class="inline-block mt-4 text-green-700 dark:text-green-400 font-semibold hover:underline">Se baneoversikt →</a>
    </div>
    <div class="text-center p-6 rounded-xl bg-green-50 dark:bg-gray-800">
      <div class="flex justify-center mb-3"><Trophy class="w-10 h-10 text-green-700 dark:text-green-400" /></div>
      <h2 class="text-xl font-bold mb-2 text-green-800 dark:text-green-300">Bli med i klubben</h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm">Spill så mye du vil – alle medlemmer har fri tilgang til banene hele sesongen.</p>
      <a href={`${base}medlemskap`} class="inline-block mt-4 text-green-700 dark:text-green-400 font-semibold hover:underline">Se medlemskap →</a>
    </div>
  </section>

  <!-- Siste nyheter -->
  {latestNews.length > 0 && (
    <section class="bg-gray-50 dark:bg-gray-900 py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-green-800 dark:text-green-300 mb-8">Siste nyheter</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {latestNews.map((post) => {
            const categories = post.data.categories?.filter(c => c !== "ukategorisert") ?? [];
            return (
              <a href={`${base}nyheter/${post.id}`} class="group block bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow px-6 py-5">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-xs font-medium text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 py-0.5 rounded-full">
                    {post.data.date.toLocaleDateString("no-NO", { day: "numeric", month: "long", year: "numeric" })}
                  </span>
                  {categories.map(cat => (
                    <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">{cat}</span>
                  ))}
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-green-700 dark:group-hover:text-green-400 transition-colors mb-0">
                  {post.data.title}
                </h3>
                {(post.data.ingress ?? post.data.description) && (
                  <p class="text-gray-600 dark:text-gray-400 text-sm mt-2 line-clamp-2">{post.data.ingress ?? post.data.description}</p>
                )}
              </a>
            );
          })}
        </div>
        <div class="mt-8 text-center">
          <a href={`${base}nyheter`} class="inline-block bg-green-700 text-white px-6 py-3 rounded-full hover:bg-green-800 transition-colors font-semibold">
            Se alle nyheter →
          </a>
        </div>
      </div>
    </section>
  )}

</Layout>
