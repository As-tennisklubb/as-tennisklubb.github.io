---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Button from "../components/ui/Button.astro";
import NewsCard from "../components/content/NewsCard.astro";
import EventCard from "../components/content/EventCard.astro";
import { fetchUpcomingEvents } from "../lib/events/fetchEvents";
import PageHeader from "../components/layout/PageHeader.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HGrid from "../components/primitives/HGrid.astro";
import HStack from "../components/primitives/HStack.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import Link from "../components/ui/Link.astro";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcomingEvents = (await fetchUpcomingEvents()).slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennisklubb – Hjem"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "no" },
    { href: new URL("english", Astro.site).href, hrefLang: "en" },
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "x-default" },
  ]}
  heroLayout
>
  {/* ───── Toppseksjon ───── */}
  <PageHeader
    variant="hero"
    title="Ås Tennisklubb"
    description="Racketsport for alle i Ås – siden 1976."
    heroCategory="tennis"
  >
    <HStack slot="actions" gap="4" wrap class="pt-2">
      <Button variant="secondary" dataColor="inverted" href={`${base}medlemskap`}>Bli medlem</Button
      >
      <Button
        variant="primary"
        dataColor="inverted"
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book bane
      </Button>
    </HStack>
  </PageHeader>

  {/* ───── Våre idretter ───── */}
  <section class="py-12 md:py-20">
    <PageBlock width="2xl" gutters>
      <VStack gap="4">
        <Heading level={2} size="medium" dataColor="brand">Tre idretter, ett medlemskap</Heading>
        <BodyLong>
          <Link href={`${base}baner/tennis`} inlineText>Tre grusbaner med kveldslys</Link> ved Ås stadion,
          <Link href={`${base}baner/padel`} inlineText>to utendørs padelbaner med kveldslys</Link> – og
          <Link href={`${base}baner/bordtennis`} inlineText>innendørs bordtennis</Link>
          hele året på Gamle Holstad skole.
        </BodyLong>
        <BodyLong>
          <strong>Tennis</strong> – Tre grusbaner med kveldslys ved Ås stadion. Gratis utlån av racketer
          og baller.
        </BodyLong>
        <BodyLong>
          <strong>Padel</strong> – To utendørs padelbaner med kveldslys, rett ved tennisanlegget. Gratis
          utlån av racketer og baller.
        </BodyLong>
        <BodyLong>
          <strong>Bordtennis</strong> – Innendørs på Gamle Holstad skole, med spillmuligheter hele året.
        </BodyLong>
        <BodyLong><strong>Alt inkludert fra kun kr 500 per år.</strong></BodyLong>
        <BodyLong>Spill tennis, padel og bordtennis med ett og samme medlemskap.</BodyLong>
      </VStack>
    </PageBlock>
  </section>

  {/* ───── Kommende arrangementer ───── */}
  {
    upcomingEvents.length > 0 && (
      <section class="py-12 md:py-20">
        <PageBlock width="2xl" gutters>
          <VStack gap="8">
            <VStack gap="2">
              <Heading level={2} size="medium" dataColor="brand">
                Kommende arrangementer
              </Heading>
              <BodyLong size="small" class="text-(--aastk-text-muted)">
                Kurs, turneringer og aktiviteter du kan delta på.
              </BodyLong>
            </VStack>
            <HGrid columns={{ sm: 1, md: 3 }} gap="6">
              {upcomingEvents.map((event) => (
                <EventCard event={event} />
              ))}
            </HGrid>
            <HStack justify="center">
              <Button href={`${base}arrangementer`}>Se alle arrangementer →</Button>
            </HStack>
          </VStack>
        </PageBlock>
      </section>
    )
  }

  {/* ───── Nytt fra klubben ───── */}
  {
    latestNews.length > 0 && (
      <section class="py-12 md:py-20">
        <PageBlock width="2xl" gutters>
          <VStack gap="8">
            <VStack gap="2">
              <Heading level={2} size="medium" dataColor="brand">
                Nytt fra klubben
              </Heading>
              <BodyLong size="small" class="text-(--aastk-text-muted)">
                Siste nytt fra klubben.
              </BodyLong>
            </VStack>
            <HGrid columns={{ sm: 1, md: 3 }} gap="6">
              {latestNews.map((post) => {
                const categories = post.data.categories?.filter((c) => c !== "ukategorisert") ?? [];
                return (
                  <NewsCard
                    href={`${base}nyheter/${post.id}`}
                    title={post.data.title}
                    date={post.data.date.toLocaleDateString("no-NO", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                    categories={categories}
                    excerpt={post.data.ingress ?? post.data.description}
                  />
                );
              })}
            </HGrid>
            <HStack justify="center">
              <Button href={`${base}nyheter`}>Se alle nyheter →</Button>
            </HStack>
          </VStack>
        </PageBlock>
      </section>
    )
  }
</Layout>
