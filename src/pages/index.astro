---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Layout title="Ås Tennisklubb – Hjem">

  <!-- Hero -->
  <section class="bg-green-800 text-white py-24 px-4 text-center">
    <h1 class="text-4xl md:text-6xl font-bold mb-4">Ås Tennisklubb</h1>
    <p class="text-green-200 text-lg md:text-xl mb-8 max-w-xl mx-auto">
      Tennis for alle – uansett alder og nivå. Bli med oss på banen!
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={`${base}medlemskap`} class="bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-full hover:bg-yellow-300 transition-colors">
        Bli medlem
      </a>
      <a href={`${base}om-klubben`} class="border border-white text-white px-8 py-3 rounded-full hover:bg-white hover:text-green-800 transition-colors">
        Les mer om oss
      </a>
    </div>
  </section>

  <!-- Info-kort -->
  <section class="max-w-6xl mx-auto px-4 py-16 grid md:grid-cols-3 gap-8">
    <div class="text-center p-6 rounded-xl bg-green-50">
      <div class="text-4xl mb-3">🎾</div>
      <h2 class="text-xl font-bold mb-2 text-green-800">Trening for alle</h2>
      <p class="text-gray-600 text-sm">Vi tilbyr trening for barn, ungdom og voksne – fra nybegynner til turnering.</p>
      <a href={`${base}trening`} class="inline-block mt-4 text-green-700 font-semibold hover:underline">Se treningsplan →</a>
    </div>
    <div class="text-center p-6 rounded-xl bg-green-50">
      <div class="text-4xl mb-3">🏟️</div>
      <h2 class="text-xl font-bold mb-2 text-green-800">Våre baner</h2>
      <p class="text-gray-600 text-sm">Vi har flotte utendørsbaner og innendørsbaner tilgjengelig for leie.</p>
      <a href={`${base}baner`} class="inline-block mt-4 text-green-700 font-semibold hover:underline">Se baneoversikt →</a>
    </div>
    <div class="text-center p-6 rounded-xl bg-green-50">
      <div class="text-4xl mb-3">🏆</div>
      <h2 class="text-xl font-bold mb-2 text-green-800">Turneringer</h2>
      <p class="text-gray-600 text-sm">Delta i klubbturneringer og rangeringsspill gjennom hele sesongen.</p>
      <a href={`${base}nyheter`} class="inline-block mt-4 text-green-700 font-semibold hover:underline">Se nyheter →</a>
    </div>
  </section>

  <!-- Siste nyheter -->
  {latestNews.length > 0 && (
    <section class="bg-gray-50 py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-green-800 mb-8">Siste nyheter</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {latestNews.map((post) => (
            <a href={`${base}nyheter/${post.id}`} class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow p-6 block">
              <div class="text-xs text-gray-400 mb-2">{post.data.date.toLocaleDateString("no-NO")}</div>
              <h3 class="font-bold text-lg text-gray-900 mb-2">{post.data.title}</h3>
              {post.data.description && <p class="text-gray-600 text-sm">{post.data.description}</p>}
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href={`${base}nyheter`} class="inline-block bg-green-700 text-white px-6 py-3 rounded-full hover:bg-green-800 transition-colors font-semibold">
            Alle nyheter →
          </a>
        </div>
      </div>
    </section>
  )}

</Layout>
