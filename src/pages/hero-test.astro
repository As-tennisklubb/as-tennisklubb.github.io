---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import fs from "node:fs";
import path from "node:path";

const base = import.meta.env.BASE_URL;

const categories = ["tennis", "padel", "bordtennis"];
const allImages: string[] = [];

for (const cat of categories) {
  const dir = path.join(process.cwd(), "public", "heroes", cat);
  if (fs.existsSync(dir)) {
    const files = fs.readdirSync(dir).filter((f) => /\.(webp|jpg|avif|png)$/i.test(f));
    for (const file of files) {
      allImages.push(`${base}heroes/${cat}/${file}`);
    }
  }
}
---

<Layout title="Hero Image Tester" noindex heroLayout>
  <PageHeader
    title="Ås Tennisklubb"
    description="Rakketsport for alle i Ås – siden 1976."
    image={allImages[0]}
  />

  <PageBlock width="xl" gutters>
    <div id="hero-tester" class="py-8 text-center" data-images={JSON.stringify(allImages)}>
      <p class="mb-4 text-lg font-bold">Hero Image Tester</p>
      <p class="mb-2 text-sm text-gray-500">
        Klikk "Neste" eller bruk piltaster for å rotere bilder. Bildet i headeren endres.
      </p>
      <div class="mb-4 flex items-center justify-center gap-4">
        <button
          id="prev-btn"
          class="rounded bg-[var(--aastk-action-primary-bg)] px-4 py-2 text-[var(--aastk-action-primary-text)] hover:bg-[var(--aastk-action-primary-bg-hover)]"
          >← Forrige</button
        >
        <span id="counter" class="font-mono text-sm">1 / {allImages.length}</span>
        <button
          id="next-btn"
          class="rounded bg-[var(--aastk-action-primary-bg)] px-4 py-2 text-[var(--aastk-action-primary-text)] hover:bg-[var(--aastk-action-primary-bg-hover)]"
          >Neste →</button
        >
      </div>
      <p id="image-name" class="mb-6 font-mono text-sm font-semibold text-brand-700"></p>

      <p class="mb-2 text-sm font-medium text-gray-600">Pattern overlay:</p>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <button
          data-set-pattern="dots"
          class="rounded border [border-color:var(--aastk-border-brand-subtle)] bg-[var(--aastk-surface-brand-soft)] px-3 py-1.5 text-sm font-medium text-[var(--aastk-text-brand)] hover:bg-[var(--aastk-action-secondary-bg-hover)]"
          >Dots</button
        >
        <button
          data-set-pattern="diagonal"
          class="rounded border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100"
          >Diagonal</button
        >
        <button
          data-set-pattern="grid"
          class="rounded border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100"
          >Grid</button
        >
        <button
          data-set-pattern="cross"
          class="rounded border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100"
          >Cross</button
        >
        <button
          data-set-pattern="none"
          class="rounded border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100"
          >Ingen</button
        >
      </div>
      <p id="pattern-name" class="mt-2 font-mono text-xs text-gray-500">Aktivt: dots</p>
    </div>
  </PageBlock>

  <script>
    function initHeroTester() {
      const tester = document.getElementById("hero-tester");
      if (!tester || tester.dataset.heroTesterInitialized === "true") return;

      const images = JSON.parse(tester.dataset.images ?? "[]") as string[];
      if (images.length === 0) return;

      const image = document.querySelector<HTMLImageElement>("[data-hero-img]");
      const name = document.getElementById("image-name");
      const counter = document.getElementById("counter");
      const nextButton = document.getElementById("next-btn");
      const previousButton = document.getElementById("prev-btn");
      const patternName = document.getElementById("pattern-name");
      if (!image || !name || !counter || !nextButton || !previousButton || !patternName) return;

      const heroImage = image;
      const imageName = name;
      const imageCounter = counter;

      tester.dataset.heroTesterInitialized = "true";
      let index = 0;

      function update() {
        heroImage.src = images[index];
        imageName.textContent = images[index].split("/").pop() ?? "";
        imageCounter.textContent = `${index + 1} / ${images.length}`;
      }

      nextButton.addEventListener("click", () => {
        index = (index + 1) % images.length;
        update();
      });

      previousButton.addEventListener("click", () => {
        index = (index - 1 + images.length) % images.length;
        update();
      });

      document.addEventListener("keydown", (event) => {
        if (!document.contains(tester)) return;
        if (event.key === "ArrowRight") {
          index = (index + 1) % images.length;
          update();
        }
        if (event.key === "ArrowLeft") {
          index = (index - 1 + images.length) % images.length;
          update();
        }
      });

      tester.querySelectorAll<HTMLElement>("[data-set-pattern]").forEach((button) => {
        button.addEventListener("click", () => {
          const pattern = button.dataset.setPattern;
          if (!pattern) return;

          document.querySelectorAll<HTMLElement>(".pattern-overlay").forEach((overlay) => {
            overlay.dataset.pattern = pattern;
          });
          patternName.textContent = `Aktivt: ${pattern}`;

          tester.querySelectorAll<HTMLElement>("[data-set-pattern]").forEach((item) => {
            item.className =
              "rounded border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100";
          });
          button.className =
            "rounded border bg-[var(--aastk-surface-brand-soft)] px-3 py-1.5 text-sm font-medium text-[var(--aastk-text-brand)] [border-color:var(--aastk-border-brand-subtle)] hover:bg-[var(--aastk-action-secondary-bg-hover)]";
        });
      });

      update();
    }

    document.addEventListener("astro:page-load", initHeroTester);
  </script>
</Layout>
