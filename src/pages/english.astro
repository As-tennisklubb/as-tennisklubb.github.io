---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import HeroSection from "../components/layout/HeroSection.astro";
import Button from "../components/ui/Button.astro";
import SectionHeading from "../components/layout/SectionHeading.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import Divider from "../components/ui/Divider.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennis Club – English"
  description="Welcome to Ås Tennis Club. Information about courts, membership and courses in English."
  lang="en"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "en" },
    { href: new URL("/", Astro.site).href, hrefLang: "no" },
    { href: new URL("/", Astro.site).href, hrefLang: "x-default" },
  ]}
>
  <!-- Hero -->
  <HeroSection size="content">
    <h1 class="mb-2 text-3xl font-bold md:text-4xl">Welcome to Ås Tennis Club</h1>
    <p class="max-w-xl text-base text-brand-200 md:text-lg">
      Tennis for everyone – regardless of age or skill level.
    </p>
  </HeroSection>

  <Container padded class="space-y-10">
    <!-- Tennis Courts -->
    <section>
      <SectionHeading title="Tennis courts" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
          We have 3 outdoor clay courts at Ås stadion, available from April to November. Reserve a
          court using our online booking system:
        </p>
      </RichTextBlock>
      <Button
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="my-6"
      >
        <CalendarCheck class="h-5 w-5" />
        Book a court
      </Button>
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
          As a member you may freely borrow rackets and balls from the club house. We recommend that
          regular players use their own rackets.
        </p>
        <p>During winter we cooperate with Drøbak Tennisklubb.</p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Membership -->
    <section>
      <SectionHeading title="Membership" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
          Register as a member via Min Idrett (Norwegian Sports Federation). You can also view
          membership fees on our membership page:
        </p>
        <p>
          <a href={`${base}medlemskap`} class="link font-semibold">
            View membership fees and registration →
          </a>
        </p>
        <p>
          After paying, send an email to
          <a href="mailto:aas.tbk@gmail.com" class="link"> aas.tbk@gmail.com </a>
          with your name and mobile number to receive access.
        </p>
        <p>
          Members get access to the courts and club house via the <strong>Yale Home app</strong>.
          Access is activated after the membership fee is paid and we have received your details.
        </p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Courses -->
    <section>
      <SectionHeading title="Courses and training" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>Ås Tennis Club offers training and courses for all ages and levels.</p>
        <p>
          <a href={`${base}arrangementer`} class="link font-semibold">
            View events, courses and training →
          </a>
        </p>
        <p>
          For more information, contact our coach at
          <a href="mailto:im@aastk.no" class="link"> im@aastk.no </a>
        </p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Contact -->
    <section>
      <SectionHeading title="Contact" />
      <p class="text-gray-700 dark:text-gray-300">
        Need more information?
        <a href={`${base}om-klubben`} class="link font-semibold"> View our contact details → </a>
      </p>
    </section>
  </Container>
</Layout>
