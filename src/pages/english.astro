---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck } from "@lucide/astro";
import Button from "../components/ui/Button.astro";
import Link from "../components/ui/Link.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";
import Process from "../components/ui/Process.astro";
import ProcessEvent from "../components/ui/ProcessEvent.astro";
import List from "../components/ui/List.astro";
import ListItem from "../components/ui/ListItem.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennis Club – English"
  description="Welcome to Ås Tennis Club. Tennis, table tennis and padel – membership, courts and courses in English."
  lang="en"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "en" },
    { href: new URL("/", Astro.site).href, hrefLang: "no" },
    { href: new URL("/", Astro.site).href, hrefLang: "x-default" },
  ]}
  heroLayout
>
  {/* ───── Header ───── */}
  <PageHeader
    variant="compact"
    title="Welcome to Ås Tennis Club"
    description="Tennis, table tennis and padel – for all ages and levels."
    heroCategory="tennis"
  />

  {/* ───── Page content ───── */}
  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* About the club */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">About the club</Heading>
          <BodyLong>
            Ås Tennis Club was founded in 1976 and is a community-driven club located next to Ås
            stadion. We offer tennis, table tennis and padel. Our members range from young children
            to retirees, and you do not need to speak Norwegian to join or play.
          </BodyLong>
          <BodyLong>
            We have three clay courts open from April to November, with two courts equipped with
            floodlights for evening play. Indoor table tennis is available year-round at Gamle
            Holstad school, and two outdoor padel courts are open during summer. Rackets and balls
            can be borrowed for free, so you do not need your own equipment to get started.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Getting started */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Getting started</Heading>
          <BodyLong>It only takes a few minutes to become a member:</BodyLong>
          <Process>
            <ProcessEvent title="Become a member" status="active">
              <Fragment slot="bullet">1</Fragment>
              <p>Register via Min Idrett and pay the annual fee.</p>
              <div>
                <Button href={`${base}medlemskap`} size="small"> Membership page → </Button>
              </div>
            </ProcessEvent>
            <ProcessEvent title="Book a court">
              <Fragment slot="bullet">2</Fragment>
              <p>Reserve a court through our online booking system.</p>
              <div>
                <Button
                  variant="secondary"
                  href={import.meta.env.PUBLIC_BOOKING_URL}
                  size="small"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <CalendarCheck class="h-5 w-5" slot="icon" />
                  Go to booking →
                </Button>
              </div>
            </ProcessEvent>
            <ProcessEvent title="Play">
              <Fragment slot="bullet">3</Fragment>
              <p>Show up and play – rackets and balls can be borrowed for free.</p>
            </ProcessEvent>
          </Process>
        </VStack>
      </PageBlock>
    </section>

    {/* Membership */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="6">
          <Heading level={2} size="medium" dataColor="brand">Membership</Heading>
          <BodyLong>
            Membership is required to use the facilities. Annual fees start from NOK 500. After
            paying, send your name and mobile number to
            <Link href="mailto:aas.tbk@gmail.com" inlineText>aas.tbk@gmail.com</Link>
            – we will set up your access through the <strong>Yale Home app</strong>.
          </BodyLong>
          <HStack gap="4" wrap>
            <Button
              href="https://medlemskap.nif.no/19967"
              target="_blank"
              rel="noopener noreferrer"
            >
              Register via Min Idrett →
            </Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>

    {/* Booking rules */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Booking rules</Heading>
          <BodyLong>
            All courts are for members only. You can book through our online booking system.
          </BodyLong>
          <List size="small">
            <ListItem title="Tennis"
              >Open 07:00–22:00 – max 2 active bookings, max 2 per day, up to 7 days in advance.</ListItem
            >
            <ListItem title="Padel"
              >Open 07:00–22:00 – max 1 active booking, max 1 per day, up to 7 days in advance.</ListItem
            >
            <ListItem title="Table tennis"
              >Open 06:00–23:00 – no booking limit at this time.</ListItem
            >
          </List>
        </VStack>
      </PageBlock>
    </section>

    {/* Events and courses */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Events and courses</Heading>
          <BodyLong>
            Throughout the season we arrange courses for all levels, club tournaments and social
            gatherings across tennis, table tennis and padel. All members are welcome to join.
          </BodyLong>
          <HStack gap="4" wrap>
            <Button variant="secondary" href={`${base}arrangementer`}>View events →</Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>

    {/* Contact */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Contact</Heading>
          <BodyLong>
            Questions about membership, facilities or events? Feel free to get in touch – we are
            happy to help, also in English.
          </BodyLong>
          <HStack gap="4" wrap>
            <Button variant="secondary" href={`${base}kontakt`}>Contact details →</Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
