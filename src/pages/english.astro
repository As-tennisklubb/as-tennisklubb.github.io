---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import HeroSection from "../components/layout/HeroSection.astro";
import Button from "../components/ui/Button.astro";
import SectionHeading from "../components/layout/SectionHeading.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import Divider from "../components/ui/Divider.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennis Club – English"
  description="Welcome to Ås Tennis Club. Information about courts, membership and courses in English."
  lang="en"
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "en" },
    { href: new URL("/", Astro.site).href, hrefLang: "no" },
    { href: new URL("/", Astro.site).href, hrefLang: "x-default" },
  ]}
>
  <!-- Hero -->
  <HeroSection>
    <h1 class="mb-3 text-3xl font-bold md:text-5xl">Welcome to Ås Tennis Club</h1>
    <p class="max-w-xl text-base text-brand-200 md:text-lg">
      Tennis for everyone – regardless of age or skill level.
    </p>
    <Button
      variant="highlight"
      href={import.meta.env.PUBLIC_BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6">Book a court</Button
    >
  </HeroSection>

  <Container padded class="space-y-12">
    <!-- Tennis Courts -->
    <section>
      <SectionHeading title="Tennis courts" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>We have 3 outdoor courts</p>
        <p>Reserve a court using our online booking system:</p>
      </RichTextBlock>
      <Button
        href={import.meta.env.PUBLIC_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="my-6"
      >
        <CalendarCheck class="h-5 w-5" />
        Book a court
      </Button>
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
          As a member you may freely borrow from the club house. We recommend that regular players
          use their own rackets.
        </p>
        <p>
          The courts are typically open from April/May until November. During winter we cooperate
          with Drøbak Tennisklubb.
        </p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Membership -->
    <section>
      <SectionHeading title="Membership" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>
          <a href={`${base}medlemskap`} class="link font-semibold">
            View membership fees and registration form →
          </a>
        </p>
        <p>
          You may also join by sending an email to
          <a href="mailto:administrasjon@aastk.no" class="link"> administrasjon@aastk.no </a>
          Please include your contact information (name, email, phone) and membership type.
        </p>
        <p>
          New members get access to the courts and club house via the <strong>Yale Home app</strong
          >. Access is activated after the membership fee is paid and we have received your name and
          mobile number.
        </p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Courses -->
    <section>
      <SectionHeading title="Courses and training" />
      <RichTextBlock class="space-y-4 text-gray-700 dark:text-gray-300">
        <p>Ås Tennis Club offers training and courses for all ages and levels.</p>
        <p>
          <a href={`${base}trening`} class="link font-semibold"> View training schedule → </a>
        </p>
        <p>
          For more information, contact our coach at
          <a href="mailto:im@aastk.no" class="link"> im@aastk.no </a>
        </p>
      </RichTextBlock>
    </section>

    <Divider />

    <!-- Contact -->
    <section>
      <SectionHeading title="Contact" />
      <p class="text-gray-700 dark:text-gray-300">
        Need more information?
        <a href={`${base}om-klubben`} class="link font-semibold"> View our contact details → </a>
      </p>
    </section>
  </Container>
</Layout>
