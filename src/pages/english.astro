---
import Layout from "../layouts/Layout.astro";
import { CalendarCheck } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import StepList from "../components/content/StepList.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ås Tennis Club – English"
  description="Welcome to Ås Tennis Club. Information about courts, membership and courses in English."
  lang="en"
  pageTitle="Welcome to Ås Tennis Club"
  pageDescription="Three clay courts at Ås stadion – open from April to November."
  languageAlternates={[
    { href: new URL(Astro.url.pathname, Astro.site).href, hrefLang: "en" },
    { href: new URL("/", Astro.site).href, hrefLang: "no" },
    { href: new URL("/", Astro.site).href, hrefLang: "x-default" },
  ]}
>
  <Container padded>
    <PageSection title="Getting started">
      <RichTextBlock class="mb-6">
        <p>Information in English about courts, membership and activities.</p>
      </RichTextBlock>
      <StepList
        steps={[
          { title: "Become a member", text: "Register via Min Idrett and pay the annual fee." },
          {
            title: "Book a court",
            text: "Reserve up to 7 days in advance via our booking system.",
          },
          {
            title: "Play",
            text: "Show up and play – rackets and balls can be borrowed for free.",
          },
        ]}
        class="mb-6"
      />
      <div class="flex flex-wrap gap-4">
        <Button href={`${base}medlemskap`}>Become a member →</Button>
        <Button
          variant="outline"
          href={import.meta.env.PUBLIC_BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <CalendarCheck class="h-5 w-5" />
          Go to booking →
        </Button>
      </div>
    </PageSection>

    <PageSection title="Membership">
      <RichTextBlock>
        <p>
          Membership is required to use the courts. Prices start from NOK 500 per year.
        </p>
        <p>
          After registering, you will need to send an email to
          <a href="mailto:aas.tbk@gmail.com" class="link">aas.tbk@gmail.com</a>
          with your name and mobile number. You will receive access to the courts and clubhouse via the <strong>Yale Home app</strong>.
        </p>
      </RichTextBlock>
      <Button
        href="https://medlemskap.nif.no/19967"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6"
      >Register via Min Idrett (Norwegian Sports Federation) →</Button>
    </PageSection>

    <PageSection title="Events and courses">
      <RichTextBlock>
        <p>
          We offer courses, training sessions, tournaments and social events throughout the
          season.
        </p>
      </RichTextBlock>
      <Button variant="outline" href={`${base}arrangementer`} class="mt-6">View events →</Button>
    </PageSection>

    <PageSection title="Contact">
      <RichTextBlock>
        <p>Questions about membership, courts or events? Get in touch with us.</p>
      </RichTextBlock>
      <Button variant="outline" href={`${base}kontakt`} class="mt-4">View contact details →</Button>
    </PageSection>
  </Container>
</Layout>
