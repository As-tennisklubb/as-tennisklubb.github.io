---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Button from "../components/ui/Button.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import LazyMap from "../components/content/LazyMap.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Om klubben – Ås Tennisklubb"
  description="Ås Tennisklubb ble grunnlagt i 1976 og holder til ved Ås stadion. Les mer om klubben."
  pageTitle="Om Ås Tennisklubb"
  pageDescription="Tennisklubb for alle i Ås – stiftet i 1976."
>
  <Container padded>
    <PageSection title="Om oss">
      <RichTextBlock>
        <p>
          Ås Tennisklubb ble grunnlagt i 1976 og holder til i Idrettsveien, rett ved Ås stadion. Vi
          er en klubb for alle – uansett alder og nivå.
        </p>
        <p>
          Med tre grusbaner, kurs og arrangementer gjennom sesongen, og et aktivt klubbmiljø er det
          alltid noe å være med på.
        </p>
      </RichTextBlock>
    </PageSection>

    <PageSection title="Klubbens beliggenhet">
      <RichTextBlock class="mb-6">
        <p>Banene ligger sentralt ved Ås stadion.</p>
      </RichTextBlock>
      <LazyMap
        address="Idrettsveien 1"
        city="1430 Ås"
        embedQuery="Idrettsveien 1, 1430 Ås, Norway"
        mapsUrl="https://maps.google.com/maps?q=Idrettsveien+1,+1430+Ås,+Norway"
      />
    </PageSection>

    <PageSection title="Bli med">
      <RichTextBlock class="mb-6">
        <p>Bli en del av klubben – spill tennis hele sesongen fra kr 500,-.</p>
      </RichTextBlock>
      <div class="flex flex-wrap gap-4">
        <Button href={`${base}medlemskap`}>Bli medlem →</Button>
        <Button variant="outline" href={`${base}kontakt`}>Kontakt oss →</Button>
      </div>
    </PageSection>
  </Container>
</Layout>
