---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Heading from "../components/ui/Heading.astro";
import BodyLong from "../components/ui/BodyLong.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HStack from "../components/primitives/HStack.astro";
import LazyMap from "../components/content/LazyMap.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Om klubben – Ås Tennisklubb"
  description="Ås Tennisklubb feirer 50 år i 2026 – les om historie, miljø og aktiviteter."
>
  {/* ───── Toppseksjon ───── */}
  <PageHeader
    title="Om Ås Tennisklubb"
    description="Klubben feirer 50 år i 2026."
    heroCategory="tennis"
  />

  {/* ───── Sideinnhold ───── */}
  <VStack gap="12" paddingBlock="6" class="md:gap-16 md:pb-16">
    {/* Om oss */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">50 år i Ås</Heading>
          <BodyLong>
            Ås Tennisklubb ble stiftet i 1976 og feirer 50-årsjubileum i 2026. Klubben har tre
            grusbaner i Idrettsveien ved Ås stadion, innendørs bordtennis på Holstad skole – og i
            jubileumsåret åpner to splitter nye padelbaner.
          </BodyLong>
          <BodyLong>
            I et halvt århundre har klubben samlet spillere i alle aldre – fra barn som slår sine
            første baller over nettet, til seniorer som har holdt det gående i flere tiår.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Klubbmiljø */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Klubbmiljø</Heading>
          <BodyLong>
            Det som kjennetegner klubben er bredden – både i alder og idretter. Medlemmene spenner
            fra skolebarn til pensjonister, og flere familier spiller på tvers av generasjonene.
            Turneringer og sosiale samlinger gir jevnlig anledning til å møtes på og utenfor banen.
          </BodyLong>
          <BodyLong>
            Klubben drives i stor grad på dugnad. Banevedlikehold, arrangementer og det meste av det
            daglige gjøres av medlemmene selv – det gir kort avstand mellom de som spiller og de som
            styrer. Årsmøtet holdes hver vinter, og alle medlemmer er velkomne.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Aktiviteter gjennom året */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Året rundt</Heading>
          <BodyLong>
            Gjennom tennissesongen arrangeres kurs for barn, ungdom og voksne på ulike nivåer.
            Racketer og baller kan lånes gratis, slik at terskelen for å prøve er lav. Bordtennis
            spilles hele året på Holstad skole, og padel blir tilgjengelig fra sommeren 2026.
          </BodyLong>
          <BodyLong>
            Hvert år spilles Ås Open og klubbmesterskapet, og på nyåret den tradisjonsrike
            Ribbeturneringen – en uhøytidelig mixed double-turnering som markerer starten på et nytt
            tennisår.
          </BodyLong>
        </VStack>
      </PageBlock>
    </section>

    {/* Klubbens beliggenhet */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Finn oss</Heading>
          <BodyLong>
            Tennisbanene og de nye padelbanene ligger i Idrettsveien ved Ås stadion. Bordtennis
            spilles på Holstad skole ved Steinerskolen i Ås.
          </BodyLong>
          <LazyMap
            address="Idrettsveien 1"
            city="1430 Ås"
            embedQuery="Idrettsveien 1, 1430 Ås, Norway"
            mapsUrl="https://maps.google.com/maps?q=Idrettsveien+1,+1430+Ås,+Norway"
          />
        </VStack>
      </PageBlock>
    </section>

    {/* Bli med */}
    <section>
      <PageBlock width="xl" gutters>
        <VStack gap="4">
          <Heading level={2} size="medium" dataColor="brand">Kom og spill</Heading>
          <BodyLong>
            Bli en del av klubben – spill fra kr 500,- i året. Alle er velkomne, uansett erfaring.
          </BodyLong>
          <HStack gap="4" wrap>
            <Button href={`${base}medlemskap`}>Bli medlem →</Button>
            <Button variant="secondary" href={`${base}kontakt`}>Kontakt oss →</Button>
          </HStack>
        </VStack>
      </PageBlock>
    </section>
  </VStack>
</Layout>
