---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/layout/HeroSection.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import EventList from "../components/events/EventList.svelte";
---

<Layout title="Arrangementer – Ås Tennisklubb" description="Hva skjer i Ås Tennisklubb.">
  <HeroSection>
    <h1 class="mb-3 text-3xl font-bold md:text-5xl">Arrangementer</h1>
    <p class="max-w-md text-base text-brand-200 md:text-lg">
      Her finner du kommende aktiviteter, dugnader og arrangementer i Ås Tennisklubb.
    </p>
  </HeroSection>

  <Container size="wide" padded>
    <PageSection>
      <EventList client:load />
    </PageSection>
  </Container>
</Layout>
