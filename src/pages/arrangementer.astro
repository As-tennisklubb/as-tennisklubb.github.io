---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/layout/HeroSection.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import Callout from "../components/ui/Callout.astro";
import EventCard from "../components/content/EventCard.astro";
import { getPublicEvents } from "../lib/events/getPublicEvents";
import type { PublicClubEvent } from "../lib/events/mapPublicEvent";

let events: PublicClubEvent[] = [];
let loadError = false;

try {
  events = await getPublicEvents();
} catch {
  loadError = true;
}
---

<Layout title="Arrangementer – Ås Tennisklubb" description="Hva skjer i Ås Tennisklubb.">
  <HeroSection>
    <h1 class="mb-3 text-3xl font-bold md:text-5xl">Arrangementer</h1>
    <p class="max-w-md text-base text-brand-200 md:text-lg">
      Her finner du kommende aktiviteter, dugnader og arrangementer i Ås Tennisklubb.
    </p>
  </HeroSection>

  <Container padded>
    <PageSection title="Kommende arrangementer">
      {
        loadError && (
          <Callout variant="warning">
            <p>Kunne ikke hente arrangementer akkurat nå. Prøv igjen litt senere.</p>
          </Callout>
        )
      }

      {
        !loadError && events.length === 0 && (
          <Callout>
            <p class="mb-1 font-medium text-gray-800 dark:text-gray-100">
              Ingen kommende arrangementer
            </p>
            <p>
              Det er ingen kommende arrangementer akkurat nå. Følg med her for dugnader, turneringer
              og andre aktiviteter i klubben.
            </p>
          </Callout>
        )
      }

      {
        !loadError && events.length > 0 && (
          <ul class="space-y-6" aria-label="Arrangementsliste">
            {events.map((event) => (
              <EventCard event={event} />
            ))}
          </ul>
        )
      }
    </PageSection>
  </Container>
</Layout>
