---
import Layout from "../layouts/Layout.astro";
import Button from "../components/aksel/Button.astro";
import EventCard from "../components/aksel/EventCard.astro";
import PageHeader from "../components/aksel/PageHeader.astro";
import Heading from "../components/aksel/Heading.astro";
import BodyLong from "../components/aksel/BodyLong.astro";
import PageBlock from "../components/primitives/PageBlock.astro";
import VStack from "../components/primitives/VStack.astro";
import HGrid from "../components/primitives/HGrid.astro";
import { fetchUpcomingEvents } from "../lib/events/fetchEvents";

const events = await fetchUpcomingEvents();
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Arrangementer – Ås Tennisklubb"
  description="Kurs, turneringer og aktiviteter i Ås Tennisklubb."
>
  {/* ───── Header ───── */}
  <PageHeader
    variant="compact"
    title="Arrangementer"
    description="Kurs, turneringer og aktiviteter i klubben."
  />

  {/* ───── Innhold ───── */}
  <PageBlock width="xl" gutters>
    <VStack gap="8" class="py-10">
      <BodyLong>
        Her finner du kurs, turneringer og andre aktiviteter i Ås Tennisklubb. Arrangementene
        oppdateres fortløpende.
      </BodyLong>

      {
        events.length === 0 ? (
          <VStack gap="4">
            <Heading level={3} size="small">Ingen kommende arrangementer</Heading>
            <BodyLong>
              Det er ingen kommende arrangementer akkurat nå. Følg med her for oppdateringer.
            </BodyLong>
            <div>
              <Button href={`${base}medlemskap`}>Bli medlem</Button>
            </div>
          </VStack>
        ) : (
          <HGrid columns={{ sm: 1, md: 2, lg: 3 }} gap="6">
            {events.map((event) => (
              <EventCard event={event} />
            ))}
          </HGrid>
        )
      }
    </VStack>
  </PageBlock>
</Layout>
