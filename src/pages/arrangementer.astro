---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Button from "../components/ui/Button.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import EventCard from "../components/events/EventCard.astro";
import { fetchUpcomingEvents } from "../lib/events/fetchEvents";

const events = await fetchUpcomingEvents();
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Arrangementer – Ås Tennisklubb"
  description="Kurs, turneringer og aktiviteter i Ås Tennisklubb."
  pageTitle="Arrangementer"
  pageDescription="Kurs, turneringer og aktiviteter i klubben."
>
  <Container padded>
    <PageSection>
      <RichTextBlock class="mb-6">
        <p>
          Her finner du kurs, turneringer og andre aktiviteter i Ås Tennisklubb. Arrangementene
          oppdateres fortløpende.
        </p>
      </RichTextBlock>

      {
        events.length === 0 ? (
          <div class="py-6">
            <p class="mb-1 font-medium text-gray-800 dark:text-gray-100">
              Ingen kommende arrangementer
            </p>
            <p class="mb-6 text-sm text-gray-600 dark:text-gray-400">
              Det er ingen kommende arrangementer akkurat nå. Følg med her for oppdateringer.
            </p>
            <Button href={`${base}medlemskap`}>Bli medlem →</Button>
          </div>
        ) : (
          <CardGrid cols={3}>
            {events.map((event) => (
              <EventCard event={event} />
            ))}
          </CardGrid>
        )
      }
    </PageSection>
  </Container>
</Layout>
