---
import Layout from "../layouts/Layout.astro";
import { CalendarClock, MessageSquare } from "@lucide/astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import ResponsiveDataList from "../components/content/ResponsiveDataList.astro";

const kurs2025 = [
  { dag: "Onsdag", gruppe: "Nybegynner 13–17 år", tid: "16.00–17.00", avgift: "100,-" },
  { dag: "Onsdag", gruppe: "Nybegynner 9–12 år", tid: "17.00–18.00", avgift: "100,-" },
  { dag: "Onsdag", gruppe: "Nybegynner 6–8 år", tid: "18.00–19.00", avgift: "100,-" },
  { dag: "Onsdag", gruppe: "Nybegynner voksen", tid: "19.00–20.00", avgift: "200,-" },
  { dag: "Torsdag", gruppe: "Øvet barn og ungdom", tid: "17.00–18.00", avgift: "100,-" },
  { dag: "Torsdag", gruppe: "Øvet voksen", tid: "18.00–19.00", avgift: "200,-" },
];
---

<Layout
  title="Trening og kurs – Ås Tennisklubb"
  description="Tenniskurs for barn og voksne i Ås Tennisklubb. Alle nivåer velkommen."
  pageTitle="Trening og kurs"
  pageDescription="Vi tilbyr kurs for alle aldersgrupper og nivåer – fra nybegynnere til viderekommende."
>
  <Container padded>
    <!-- 2026-melding
	<PageSection>
	  <div class="flex items-start gap-4 bg-brand-50 dark:bg-gray-800 border border-brand-200 dark:border-brand-800 rounded-xl p-6">
		<CalendarClock class="w-6 h-6 text-brand-700 dark:text-brand-400 shrink-0 mt-0.5" />
		<div>
		  <h2 class="font-semibold text-brand-800 dark:text-brand-300 mb-1">Kurs 2026 – informasjon kommer snart</h2>
		  <p class="text-sm text-gray-600 dark:text-gray-400">
			Kursprogrammet for 2026 er ikke klart ennå. Følg med på
			<a href="nyheter" class="text-brand-700 dark:text-brand-400 hover:underline">nyhetssiden</a> for oppdateringer,
			eller kontakt tennistrener Sondre Lundqvist på
			<a href="tel:+4746535792" class="text-brand-700 dark:text-brand-400 hover:underline">465 35 792</a>.
		  </p>
		</div>
	  </div>
	</PageSection>
	-->

    <!-- Kurs 2025 som referanse -->
    <PageSection title="Kursoversikt" icon={CalendarClock}>
      <p class="mb-6 text-gray-700 dark:text-gray-300">
        Basert på høsten 2025 – tidspunkter kan endres for 2026.
      </p>

      <ResponsiveDataList>
        <Fragment slot="mobile">
          {
            kurs2025.map(({ dag, gruppe, tid, avgift }) => (
              <div class="data-card">
                <div class="mb-1 flex items-start justify-between">
                  <span class="text-sm font-semibold text-gray-900 dark:text-gray-100">
                    {gruppe}
                  </span>
                  <span class="text-sm font-bold text-brand-700 dark:text-brand-400">
                    kr {avgift}
                  </span>
                </div>
                <span class="text-xs text-gray-500 dark:text-gray-400">
                  {dag} {tid}
                </span>
              </div>
            ))
          }
        </Fragment>
        <Fragment slot="desktop">
          <table class="data-table">
            <thead>
              <tr>
                <th>Dag</th>
                <th>Gruppe</th>
                <th>Tid</th>
                <th class="text-right">Påmeldingsavgift</th>
              </tr>
            </thead>
            <tbody>
              {
                kurs2025.map(({ dag, gruppe, tid, avgift }) => (
                  <tr>
                    <td>{dag}</td>
                    <td class="font-medium text-gray-900 dark:text-gray-100">{gruppe}</td>
                    <td>{tid}</td>
                    <td class="text-right font-semibold text-brand-700 dark:text-brand-400">
                      kr {avgift}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </Fragment>
      </ResponsiveDataList>

      <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">
        * Påmeldingsavgift betales til kontonr. 1100 44 76109 eller Vipps til Ås Tennisklubb #14506.
      </p>
    </PageSection>

    <!-- Påmelding -->
    <PageSection title="Påmelding" icon={MessageSquare}>
      <RichTextBlock>
        <p>
          Send SMS til tennistrener <strong>Sondre Lundqvist</strong> på
          <a href="tel:+4746535792">465 35 792</a>. Alle spørsmål om kurs besvares av treneren. Vi
          oppfordrer alle kursdeltakere til å melde seg inn som medlemmer – medlemmer kan spille så
          mye de vil gratis på banene.
        </p>
      </RichTextBlock>
    </PageSection>
  </Container>
</Layout>
