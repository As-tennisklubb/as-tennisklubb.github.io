---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Card from "../components/ui/Card.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
import Button from "../components/ui/Button.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Utstyr – Ås Tennisklubb"
  description="Les om klubbhuset, utlån av racketer og baller, og ballmaskiner hos Ås Tennisklubb."
  pageTitle="Utstyr"
  pageDescription="Racketer, baller og ballmaskiner – tilgjengelig for alle medlemmer."
>
  <Container padded>
    <!-- Utlån -->
    <PageSection title="Racketer og baller">
      <RichTextBlock class="mb-6">
        <p>
          Du trenger ikke eget utstyr for å spille. Nye spillere kan låne racketer og baller gratis
          i klubbhuset.
        </p>
        <p>
          Vi anbefaler at faste spillere tar med egen racket. Lånt utstyr må settes tilbake etter
          bruk.
        </p>
        <p>For barn inntil 10 år anbefales saktegående røde, oransje eller grønne baller.</p>
      </RichTextBlock>
      <Callout>
        For strenging av racketer – ta kontakt med Magnus Holmqvist i Drøbak tennisklubb
        <a href="tel:+4792894247" class="link ml-1 font-medium">928 94 247</a>.
      </Callout>
    </PageSection>

    <!-- Ballmaskiner -->
    <PageSection title="Ballmaskiner">
      <CardGrid cols={2}>
        <Card
          title="Liten ballmaskin"
          description="Batteridrevet og lett å flytte rundt på banen. Passer for de yngste og nybegynnere, og kan betjenes av de aller minste."
        />
        <Card
          title="Stor ballmaskin"
          description="Rommer 125 baller og skyter både hardt (inntil 96 km/t) og løst. Kan variere retning og pause mellom slagene – passer til spillere på flere nivåer."
        />
      </CardGrid>
    </PageSection>

    <!-- Klubbhuset -->
    <PageSection title="Klubbhuset">
      <RichTextBlock>
        <p>
          Klubbhuset ligger like ved banene. Her finner du alt utstyr, toalett og vask. Tilgang via
          Yale Home-appen – samme løsning som for banene.
        </p>
        <p>Bryteren for lysanlegget og vanningsanlegget er inne i klubbhuset.</p>
      </RichTextBlock>
    </PageSection>

    <PageSection title="Klar til å spille?">
      <RichTextBlock class="mb-6">
        <p>Alt utstyr er tilgjengelig for medlemmer i klubbhuset.</p>
      </RichTextBlock>
      <div class="flex flex-wrap gap-4">
        <Button href={import.meta.env.PUBLIC_BOOKING_URL} target="_blank" rel="noopener noreferrer"
          >Book bane →</Button
        >
        <Button variant="outline" href={`${base}medlemskap`}>Bli medlem →</Button>
      </div>
    </PageSection>
  </Container>
</Layout>
