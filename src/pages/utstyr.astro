---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import PageSection from "../components/layout/PageSection.astro";
import CardGrid from "../components/layout/CardGrid.astro";
import Card from "../components/ui/Card.astro";
import Callout from "../components/ui/Callout.astro";
import RichTextBlock from "../components/ui/RichTextBlock.astro";
---

<Layout
  title="Utstyr – Ås Tennisklubb"
  description="Les om klubbhuset, utlån av racketer og baller, og ballmaskiner hos Ås Tennisklubb."
  pageTitle="Utstyr"
  pageDescription="Alt av utstyr og fasiliteter tilgjengelig for medlemmer."
>
  <Container padded>
    <!-- Klubbhuset -->
    <PageSection title="Klubbhuset">
      <RichTextBlock>
        <p>
          Klubbhuset ligger like ved banen. For å komme inn bruker du <strong
            >Yale Home-appen</strong
          > – samme løsning som gir tilgang til banene. Her finner du baller, racketer og ballmaskiner.
          Det er også toalett og vask.
        </p>
        <p>Bryteren for lysanlegget og vanningsanlegget er inne i klubbhuset.</p>
      </RichTextBlock>
    </PageSection>

    <!-- Racketer og baller -->
    <PageSection title="Tennisballer og racketer">
      <RichTextBlock class="mb-6">
        <p>Vi anbefaler medlemmer å ta med egen racket og baller.</p>
        <p>
          Nye spillere kan finne racketer og baller til utlån i klubbhuset. Lånte racketer og baller
          må settes tilbake etter bruk.
        </p>
        <p>
          Det anbefales at barn inntil 10 år bruker mer saktegående røde, oransje eller grønne
          baller.
        </p>
      </RichTextBlock>
      <Callout>
        For strenging av racketer – ta kontakt med Magnus Holmqvist i Drøbak tennisklubb
        <a href="tel:+4792894247" class="link ml-1 font-medium">928 94 247</a>.
      </Callout>
    </PageSection>

    <!-- Ballmaskiner -->
    <PageSection title="Ballmaskiner">
      <CardGrid cols={2}>
        <Card
          title="Liten ballmaskin"
          description="Batteridrevet og lett å flytte rundt på banen. Passer for de yngste og nybegynnere, og kan betjenes av de aller minste."
        />
        <Card
          title="Stor ballmaskin"
          description="Rommer 125 baller og skyter både hardt (inntil 96 km/t) og løst. Kan variere retning og pause mellom slagene – passer til spillere på flere nivåer."
        />
      </CardGrid>
    </PageSection>
  </Container>
</Layout>
